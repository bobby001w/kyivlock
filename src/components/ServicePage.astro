---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Blocks from './Blocks.astro';
import W from './Widgets.astro';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import Thumb from './Thumb.astro';
import { SERVICES, IGN, type Service } from '../data/services';
import { IGN_PAGES, IGN_FAQ, IGN_HUB, HOWTO_STEPS } from '../data/ignition';
import { DISTRICTS } from '../data/kyiv';
import { service as svcSchema, faqPage, howTo } from '../lib/schema';
import { fill } from '../lib/seo';
import { placeUrl, comboUrl, ignitionCombos, doorCombos, IGN_COMBO, DOOR_COMBO } from '../lib/site';
import { getCollection } from 'astro:content';
import { t, blogCollection } from '../i18n/ctx';

interface Props { svc: Service; ign?: boolean }
const { svc, ign = false } = Astro.props;
const all = [...SERVICES, ...IGN_PAGES, { path: IGN, name: IGN_HUB.name, short: t('Ключі запалювання', 'Ключи зажигания'), icon: 'ignition', lead: IGN_HUB.lead } as Service];
const related = svc.related.map((p) => all.find((s) => s.path === p)).filter(Boolean) as Service[];
const posts = await getCollection(blogCollection());
const relatedBlog = posts.filter((p) => svc.related.includes(`/blog/${p.id}/`) || p.data.related.includes(svc.path));
// Для підпослуг запалювання FAQ доповнюємо загальними питаннями до мінімум 8 (розділ 5А.5)
const faq = ign ? [...svc.faq, ...IGN_FAQ.filter((q) => !svc.faq.some((x) => x.q === q.q))].slice(0, Math.max(8, svc.faq.length)) : svc.faq;
const crumbs = ign
  ? [{ name: t('Послуги', 'Услуги'), href: '/poslugy/' }, { name: t('Ключі запалювання', 'Ключи зажигания'), href: IGN }, { name: svc.short, href: svc.path }]
  : [{ name: t('Послуги', 'Услуги'), href: '/poslugy/' }, { name: svc.short, href: svc.path }];
const geo = ign
  ? ignitionCombos.map((p) => ({ href: comboUrl(p, IGN_COMBO), name: `${svc.short.split(',')[0]} ${p.loc}` }))
  : svc.slug === 'vidkryttia-dverey'
    ? doorCombos.map((p) => ({ href: comboUrl(p, DOOR_COMBO), name: `${t('Відкриття дверей', 'Вскрытие дверей')} ${p.loc}` }))
    : DISTRICTS.map((p) => ({ href: placeUrl(p), name: `${svc.short} ${p.loc}` }));
const schema = [
  svcSchema({ name: svc.name, type: svc.serviceType, path: svc.path, description: svc.lead, priceIds: svc.priceIds }),
  faqPage(faq),
  ...(svc.slug === 'kliuch-ne-povertaietsia' ? [howTo(t('Що робити, якщо ключ запалювання не повертається', 'Что делать, если ключ зажигания не поворачивается'), HOWTO_STEPS)] : []),
];
const [first, ...rest] = svc.sections;
---
<Base title={svc.title} description={svc.description} path={svc.path} crumbs={crumbs} schema={schema} ogImage={`/images/${svc.image.file}-1200.webp`}>
  <Hero h1={svc.h1} lead={svc.lead} variant={ign ? 'ignition' : 'default'} />
  <section class="section"><div class="wrap two">
    <div class="prose">
      <h2>{first.h2}</h2>
      <Fragment set:html={first.html} />
      {first.sub?.map((s) => <><h3>{s.h3}</h3><Fragment set:html={s.html} /></>)}
    </div>
    <div><W type="img" file={svc.image.file} alt={svc.image.alt} /></div>
  </div></section>
  {ign ? <Blocks type="steps-ign" /> : <Blocks type="steps" seed={svc.slug} />}
  <section class="section"><div class="wrap prose">
    {rest.map((s) => (
      <>
        <h2>{s.h2}</h2>
        <Fragment set:html={s.html} />
        {s.sub?.map((x) => <><h3>{x.h3}</h3><Fragment set:html={x.html} /></>)}
      </>
    ))}
    {svc.slug === 'kliuch-ne-povertaietsia' && (
      <>
        <h2>{t('Покрокова інструкція: що робити, якщо ключ не повертається', 'Пошаговая инструкция: что делать, если ключ не поворачивается')}</h2>
        <ol>{HOWTO_STEPS.map((s) => <li><strong>{s.name}.</strong> {s.text}</li>)}</ol>
      </>
    )}
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>{t('Ціни', 'Цены')}: {svc.short.toLowerCase()}</h2>
    <W type="prices" ids={svc.priceIds} />
    <p><a href="/tsiny/">{t('Усі ціни на послуги', 'Все цены на услуги')}</a></p>
  </div></section>
  <Blocks type={ign || svc.slug === 'vidkryttia-avto' ? 'ownership-car' : 'ownership'} seed={svc.slug} />
  {ign && <><Blocks type="ign-wait" /><Blocks type="ign-timing" /><Blocks type="workshop" /></>}
  <Blocks type="guarantee" />
  <section class="section soft"><div class="wrap">
    <h2>{t('Відгуки клієнтів', 'Отзывы клиентов')}</h2>
    <W type="reviews" service={svc.path} />
  </div></section>
  <section class="section"><div class="wrap two">
    <div><h2>{t('Питання і відповіді', 'Вопросы и ответы')}</h2><W type="faq" items={faq} /></div>
    <div><LeadForm variant={ign ? 'ignition' : 'default'} uid="bottom" title={t('Викликати майстра', 'Вызвать мастера')} /></div>
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>{t('Схожі послуги', 'Похожие услуги')}</h2>
    <div class="grid g4">
      {related.map((r) => <a class="card has-img" href={r.path}><Thumb file={r.image?.file ?? 'remont-zamka-zapaliuvannia-kyiv'} alt={r.image?.alt ?? t('Кермо і ключ у замку запалювання автомобіля', 'Руль и ключ в замке зажигания автомобиля')} /><h3>{r.name}</h3></a>)}
    </div>
    {relatedBlog.length > 0 && <><h2 style="margin-top:32px">{t('Корисні статті', 'Полезные статьи')}</h2><ul class="cols">{relatedBlog.map((b) => <li><a href={`/blog/${b.id}/`}>{b.data.title}</a></li>)}</ul></>}
    <h2 style="margin-top:32px">{ign ? t('Ремонт замка запалювання у вашому районі', 'Ремонт замка зажигания в вашем районе') : `${svc.short} ${t('у вашому районі', 'в вашем районе')}`}</h2>
    <W type="links" links={geo} />
  </div></section>
</Base>
