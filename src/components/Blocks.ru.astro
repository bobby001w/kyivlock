---
// Русская версия набора повторяющихся смысловых блоков (см. Blocks.uk.astro).
// Варианты текстов зависят от `seed` (slug страницы), чтобы шаблонные абзацы отличались между страницами.
import Icon from './Icon.astro';
import { vary } from '../lib/seo';
import { BUSINESS } from '../data/business';
interface Props { type: 'steps' | 'steps-ign' | 'ownership' | 'ownership-car' | 'advantages' | 'ign-wait' | 'ign-timing' | 'guarantee' | 'workshop'; seed?: string; where?: string }
const { type, seed = '', where = 'по Киеву' } = Astro.props;

const stepIntro = vary(seed, [
  'От звонка до открытой двери — четыре прозрачных шага без сюрпризов в цене.',
  'Мы работаем по простой схеме, чтобы вы знали, что происходит на каждом этапе.',
  'Каждый вызов проходит одинаковые шаги — так мы гарантируем скорость и честную цену.',
]);
const ownIntro = vary(seed, [
  'Мы вскрываем двери только владельцам и жильцам — и проверяем это в каждом случае.',
  'Безопасность клиентов важнее скорости: без подтверждения права на жильё мы не вскрываем.',
  'Честный мастер всегда проверяет документы. Это защищает вас от мошенников, а нас — от участия в преступлении.',
]);
---
{type === 'steps' && (
  <section class="section soft" aria-labelledby={`st-${seed}`}><div class="wrap">
    <h2 id={`st-${seed}`}>Как мы работаем {where}</h2>
    <p>{stepIntro}</p>
    <ol class="steps">
      <li><b>Звонок</b>Опишите ситуацию: тип двери, замка или авто. Диспетчер назовёт ориентировочную цену и время приезда.</li>
      <li><b>Выезд мастера</b>Ближайший свободный мастер выезжает сразу. Вы получаете его имя и номер авто.</li>
      <li><b>Проверка и фиксированная цена</b>Мастер проверяет документы, осматривает замок и называет окончательную цену до начала работ.</li>
      <li><b>Вскрытие и гарантия</b>Вскрываем без повреждений, при необходимости меняем замок.</li>
    </ol>
  </div></section>
)}
{type === 'steps-ign' && (
  <section class="section soft"><div class="wrap">
    <h2>Как мы работаем с ключами и замками зажигания</h2>
    <ol class="steps s5">
      <li><b>Звонок</b>Позвоните или напишите в мессенджер.</li>
      <li><b>Марка, год, VIN</b>Уточняем модель и год авто, при необходимости — VIN, чтобы взять нужную личинку или заготовку ключа.</li>
      <li><b>Выезд или мастерская</b>Приезжаем к авто или принимаем его в мастерской (организуем эвакуатор).</li>
      <li><b>Диагностика и фиксированная цена</b>Определяем причину и называем окончательную стоимость до начала работ.</li>
      <li><b>Работа и гарантия</b>Ремонт, замена или изготовление ключа, проверка всех функций.</li>
    </ol>
  </div></section>
)}
{(type === 'ownership' || type === 'ownership-car') && (
  <section class="section"><div class="wrap"><div class="trust">
    <h2><Icon name="shield" class="ic" /> Проверка права собственности и законность</h2>
    <p>{ownIntro}</p>
    {type === 'ownership' ? (
      <ul>
        <li><strong>Жильё:</strong> паспорт с регистрацией по адресу, договор купли-продажи или аренды, свидетельство о праве собственности или выписка из реестра.</li>
        <li><strong>Если документы внутри</strong> — вскрываем и проверяем их сразу после вскрытия, в присутствии соседей или представителя ОСМД.</li>
        <li><strong>Офис или магазин:</strong> документ на помещение, доверенность или приказ руководителя.</li>
        <li><strong>Сейф:</strong> документ на помещение и лицо, имеющее право распоряжаться имуществом.</li>
      </ul>
    ) : (
      <ul>
        <li><strong>Свидетельство о регистрации ТС (техпаспорт)</strong> и документ, удостоверяющий личность.</li>
        <li><strong>Доверенность</strong> или путевой лист — если авто оформлено не на вас или принадлежит компании.</li>
        <li><strong>Сверка VIN</strong> на кузове с документами; при необходимости — фото VIN.</li>
        <li>Без документов ключи не изготавливаем и замки зажигания не меняем — ни за какие деньги.</li>
      </ul>
    )}
    <p><strong>Фиксированная цена называется до начала работ.</strong></p>
  </div></div></section>
)}
{type === 'advantages' && (
  <section class="section"><div class="wrap">
    <h2>Почему выбирают KyivLock</h2>
    <div class="grid g4">
      <div class="card"><Icon name="clock" /><h3>Выезд от 15 минут</h3><p>Мастера на правом и левом берегу — не зависим от пробок на мостах.</p></div>
      <div class="card"><Icon name="door" /><h3>Без повреждений</h3><p>Неразрушающее вскрытие профессиональным инструментом в более чем 90% случаев.</p></div>
      <div class="card"><Icon name="shield" /><h3>Честная цена</h3><p>Фиксированная стоимость до начала работ, без скрытых доплат и «накруток» на месте.</p></div>
      <div class="card"><Icon name="check" /><h3>Гарантия</h3><p>Даём гарантию на выполненные работы, на детали — гарантия производителя.</p></div>
    </div>
  </div></section>
)}
{type === 'ign-wait' && (
  <section class="section"><div class="wrap">
    <h2>Пока ждёте мастера</h2>
    <div class="do-dont">
      <div class="do"><h3>Что можно сделать</h3><ul>
        <li>Слегка покачайте руль влево-вправо, поворачивая ключ без усилия.</li>
        <li>Переключите селектор АКПП в P или N с нажатым тормозом.</li>
        <li>Попробуйте запасной ключ.</li>
        <li>Подготовьте техпаспорт, удостоверение личности и фото VIN.</li>
        <li>Зимой — согрейте ключ в руке или тёплым воздухом.</li>
      </ul></div>
      <div class="dont"><h3>Чего делать нельзя</h3><ul>
        <li>Не проворачивайте ключ силой и плоскогубцами — он сломается в личинке.</li>
        <li>Не лейте кипяток на замок и не грейте его открытым огнём.</li>
        <li>Не брызгайте WD-40 в личинку — он смывает смазку.</li>
        <li>Не снимайте кожух рулевой колонки — рядом подушка безопасности.</li>
        <li>Не доверяйте «мастерам», которые не спрашивают документы.</li>
      </ul></div>
    </div>
  </div></section>
)}
{type === 'ign-timing' && (
  <section class="section soft"><div class="wrap">
    <h2>Сколько это занимает</h2>
    <ul>
      <li><strong>Ремонт или замена личинки зажигания</strong> — ориентировочно 30–90 минут.</li>
      <li><strong>Извлечение сломанного ключа</strong> — 20–60 минут.</li>
      <li><strong>Ключ с чипом по образцу</strong> — от 30 минут; зависит от марки и типа транспондера.</li>
      <li><strong>Смарт-ключ</strong> — от 1 до 4 часов.</li>
      <li><strong>Утеряны все ключи</strong> — от 1 до 6 часов; для части авто — в мастерской.</li>
    </ul>
    <p class="muted">Для части авто нужны диагностика и программирование блоков. Точное время назовём после уточнения марки, года и VIN — без обещаний, которые невозможно выполнить.</p>
  </div></section>
)}
{type === 'guarantee' && (
  <section class="section"><div class="wrap">
    <h2>Гарантия на работу и комплектующие</h2>
    <p>На работы с замками зажигания и ключами действует <strong>гарантия</strong>, как и на работы с замками дверей. На комплектующие (личинки, замки, заготовки ключей, чипы) — гарантия производителя. Если в гарантийный период появится проблема, связанная с нашей работой, — приедем и устраним бесплатно. Условия — на странице <a href="/harantiia/">«Гарантия и возврат средств»</a>.</p>
  </div></section>
)}
{type === 'workshop' && (
  <section class="section soft"><div class="wrap">
    <h2>Выезд мастера или мастерская</h2>
    <div class="two">
      <div class="card"><h3>Выезд к авто</h3><p>Большинство работ выполняем на месте — во дворе, на парковке, у офиса или на трассе: ремонт и замена личинки, извлечение обломка ключа, ключи с чипом, ремонт выкидных ключей, вскрытие авто.</p></div>
      <div class="card"><h3>Мастерская</h3><p>Сложные случаи — замену замка руля, программирование блоков, All keys lost на премиальных марках — делаем в мастерской{BUSINESS.workshopAddress && <>: <strong>{BUSINESS.workshopAddress}</strong></>}. При необходимости организуем эвакуатор.</p></div>
    </div>
  </div></section>
)}
