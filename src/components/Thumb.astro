---
// Фото-обкладинка для картки (послуги, статті блогу): AVIF/WebP 480/800 px, lazy, пропорції 16:10.
// На телефоні картка на всю ширину — браузер бере 480 або 800 px залежно від щільності екрана.
interface Props { file: string; alt: string }
const { file, alt } = Astro.props;
const set = (ext: string) => [480, 800].map((w) => `/images/${file}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(min-width: 960px) 280px, (min-width: 640px) 45vw, 100vw';
---
<picture class="card-img">
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img src={`/images/${file}-480.webp`} alt={alt} width="480" height="300" loading="lazy" decoding="async" />
</picture>
