---

import { t } from '../i18n/ctx';interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label={t('Хлібні крихти', 'Хлебные крошки')}>
  <div class="wrap"><ol>
    {items.map((c, i) => <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
  </ol></div>
</nav>
