---
// Набір повторюваних змістових блоків. Вибір блока — через prop `type`.
// Варіанти текстів залежать від `seed` (slug сторінки), щоб шаблонні абзаци різнилися між сторінками.
import Icon from './Icon.astro';
import { vary } from '../lib/seo';
import { BUSINESS } from '../data/business';
interface Props { type: 'steps' | 'steps-ign' | 'ownership' | 'ownership-car' | 'advantages' | 'ign-wait' | 'ign-timing' | 'guarantee' | 'workshop'; seed?: string; where?: string }
const { type, seed = '', where = 'по Києву' } = Astro.props;

const stepIntro = vary(seed, [
  'Від дзвінка до відчинених дверей — чотири прозорі кроки без сюрпризів у ціні.',
  'Ми працюємо за простою схемою, щоб ви знали, що відбувається на кожному етапі.',
  'Кожен виклик проходить однакові кроки — так ми гарантуємо швидкість і чесну ціну.',
]);
const ownIntro = vary(seed, [
  'Ми відкриваємо двері лише власникам і мешканцям — і перевіряємо це в кожному випадку.',
  'Безпека клієнтів важливіша за швидкість: без підтвердження права на житло ми не відкриваємо.',
  'Чесний майстер завжди перевіряє документи. Це захищає вас від шахраїв, а нас — від участі в злочині.',
]);
---
{type === 'steps' && (
  <section class="section soft" aria-labelledby={`st-${seed}`}><div class="wrap">
    <h2 id={`st-${seed}`}>Як ми працюємо {where}</h2>
    <p>{stepIntro}</p>
    <ol class="steps">
      <li><b>Дзвінок</b>Опишіть ситуацію: тип дверей, замка чи авто. Диспетчер назве орієнтовну ціну й час приїзду.</li>
      <li><b>Виїзд майстра</b>Найближчий вільний майстер виїжджає одразу. Ви отримуєте його ім'я та номер авто.</li>
      <li><b>Перевірка й фіксована ціна</b>Майстер перевіряє документи, оглядає замок і називає остаточну ціну до початку робіт.</li>
      <li><b>Відкриття і гарантія</b>Відкриваємо без пошкоджень, за потреби міняємо замок.</li>
    </ol>
  </div></section>
)}
{type === 'steps-ign' && (
  <section class="section soft"><div class="wrap">
    <h2>Як ми працюємо з ключами та замками запалювання</h2>
    <ol class="steps s5">
      <li><b>Дзвінок</b>Зателефонуйте або напишіть у месенджер.</li>
      <li><b>Марка, рік, VIN</b>Уточнюємо модель і рік авто, за потреби — VIN, щоб взяти потрібну личинку чи заготовку ключа.</li>
      <li><b>Виїзд або майстерня</b>Приїжджаємо до авто або приймаємо його в майстерні (організуємо евакуатор).</li>
      <li><b>Діагностика і фіксована ціна</b>Визначаємо причину та називаємо остаточну вартість до початку робіт.</li>
      <li><b>Робота і гарантія</b>Ремонт, заміна чи виготовлення ключа, перевірка всіх функцій.</li>
    </ol>
  </div></section>
)}
{(type === 'ownership' || type === 'ownership-car') && (
  <section class="section"><div class="wrap"><div class="trust">
    <h2><Icon name="shield" class="ic" /> Перевірка власності та законність</h2>
    <p>{ownIntro}</p>
    {type === 'ownership' ? (
      <ul>
        <li><strong>Житло:</strong> паспорт з реєстрацією за адресою, договір купівлі чи оренди, свідоцтво про право власності або витяг з реєстру.</li>
        <li><strong>Якщо документи всередині</strong> — відкриваємо та перевіряємо їх одразу після відкриття, у присутності сусідів чи представника ОСББ.</li>
        <li><strong>Офіс чи магазин:</strong> документ на приміщення, довіреність або наказ від керівника.</li>
        <li><strong>Сейф:</strong> документ на приміщення та особа, що має право розпоряджатися майном.</li>
      </ul>
    ) : (
      <ul>
        <li><strong>Свідоцтво про реєстрацію ТЗ (техпаспорт)</strong> і документ, що посвідчує особу.</li>
        <li><strong>Довіреність</strong> або путівка — якщо авто не на вас чи належить компанії.</li>
        <li><strong>Звірка VIN</strong> на кузові з документами; за потреби — фото VIN.</li>
        <li>Без документів ключі не виготовляємо і замки запалювання не міняємо — за жодну ціну.</li>
      </ul>
    )}
    <p><strong>Фіксована ціна називається до початку робіт.</strong></p>
  </div></div></section>
)}
{type === 'advantages' && (
  <section class="section"><div class="wrap">
    <h2>Чому обирають KyivLock</h2>
    <div class="grid g4">
      <div class="card"><Icon name="clock" /><h3>Виїзд від 15 хвилин</h3><p>Майстри на правому та лівому березі — не залежимо від заторів на мостах.</p></div>
      <div class="card"><Icon name="door" /><h3>Без пошкоджень</h3><p>Неруйнівне відкриття професійним інструментом у понад 90% випадків.</p></div>
      <div class="card"><Icon name="shield" /><h3>Чесна ціна</h3><p>Фіксована вартість до початку робіт, без прихованих доплат і «накруток» на місці.</p></div>
      <div class="card"><Icon name="check" /><h3>Гарантія</h3><p>Даємо гарантію на виконані роботи, на деталі — гарантія виробника.</p></div>
    </div>
  </div></section>
)}
{type === 'ign-wait' && (
  <section class="section"><div class="wrap">
    <h2>Поки чекаєте майстра</h2>
    <div class="do-dont">
      <div class="do"><h3>Що можна зробити</h3><ul>
        <li>Злегка покрутіть кермо вліво-вправо, повертаючи ключ без зусиль.</li>
        <li>Перемкніть селектор АКПП у P або N з натиснутим гальмом.</li>
        <li>Спробуйте запасний ключ.</li>
        <li>Підготуйте техпаспорт, посвідчення особи та фото VIN.</li>
        <li>Узимку — зігрійте ключ у руці або теплим повітрям.</li>
      </ul></div>
      <div class="dont"><h3>Чого не можна робити</h3><ul>
        <li>Не крутіть ключ силою і плоскогубцями — він зламається в личинці.</li>
        <li>Не лийте окріп на замок і не грійте його відкритим вогнем.</li>
        <li>Не бризкайте WD-40 у личинку — він змиває мастило.</li>
        <li>Не знімайте кожух кермової колонки — поруч подушка безпеки.</li>
        <li>Не довіряйте «майстрам», які не питають документів.</li>
      </ul></div>
    </div>
  </div></section>
)}
{type === 'ign-timing' && (
  <section class="section soft"><div class="wrap">
    <h2>Скільки це займає</h2>
    <ul>
      <li><strong>Ремонт або заміна личинки запалювання</strong> — орієнтовно 30–90 хвилин.</li>
      <li><strong>Витяг зламаного ключа</strong> — 20–60 хвилин.</li>
      <li><strong>Ключ з чіпом за зразком</strong> — від 30 хвилин; залежить від марки та типу транспондера.</li>
      <li><strong>Смарт-ключ</strong> — від 1 до 4 годин.</li>
      <li><strong>Втрачені всі ключі</strong> — від 1 до 6 годин; для частини авто — в майстерні.</li>
    </ul>
    <p class="muted">Для частини авто потрібні діагностика та програмування блоків. Точний час назвемо після уточнення марки, року і VIN — без обіцянок, які неможливо виконати.</p>
  </div></section>
)}
{type === 'guarantee' && (
  <section class="section"><div class="wrap">
    <h2>Гарантія на роботу та комплектуючі</h2>
    <p>На роботи з замками запалювання і ключами діє <strong>гарантія</strong>, як і на роботи з замками дверей. На комплектуючі (личинки, замки, заготовки ключів, чіпи) — гарантія виробника. Якщо в гарантійний період з'явиться проблема, пов'язана з нашою роботою, — приїдемо й усунемо безкоштовно. Умови — на сторінці <a href="/harantiia/">«Гарантія та повернення коштів»</a>.</p>
  </div></section>
)}
{type === 'workshop' && (
  <section class="section soft"><div class="wrap">
    <h2>Мобільний виїзд чи майстерня</h2>
    <div class="two">
      <div class="card"><h3>Виїзд до авто</h3><p>Більшість робіт виконуємо на місці — у дворі, на парковці, біля офісу чи на трасі: ремонт і заміна личинки, витяг уламка ключа, ключі з чіпом, ремонт викидних ключів, відкриття авто.</p></div>
      <div class="card"><h3>Майстерня</h3><p>Складні випадки — заміна замка керма, програмування блоків, All keys lost на преміальних марках — робимо в майстерні{BUSINESS.workshopAddress && <>: <strong>{BUSINESS.workshopAddress}</strong></>}. За потреби організуємо евакуатор.</p></div>
    </div>
  </div></section>
)}
