---
// Русская версия шаблона геостраницы (см. PlacePage.uk.astro). Данные — из src/data/ru/.
// Уникальность: факты локации (жильё, улицы, метро, ориентиры, проблемы, время) + блоки родительского
// района + вариативные абзацы (vary по slug).
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Blocks from './Blocks.astro';
import W from './Widgets.astro';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import type { Place } from '../data/kyiv';
import { DISTRICTS } from '../data/kyiv';
import { LOCAL, TIPS } from '../data/local';
import { SERVICES, IGN } from '../data/services';
import { price, fmt, PRICE_FROM } from '../data/prices';
import { placeTitle, placeDesc, vary } from '../lib/seo';
import { faqPage, service as svcSchema } from '../lib/schema';
import { place, placeUrl, neighbors, children, comboUrl, IGN_COMBO, DOOR_COMBO } from '../lib/site';

interface Props { p: Place }
const { p } = Astro.props;
const isKyiv = p.kind === 'district' || p.kind === 'micro';
const parent = p.parent ? place(p.parent) : undefined;
const url = placeUrl(p);
const kids = children(p);
const near = neighbors(p);
const microLinks = (p.micros ?? []).map((m) => ({ ...m, href: m.slug && place(m.slug) ? placeUrl(place(m.slug)!) : undefined }));
const hasIgn = !!p.ignition;
const hasDoor = !!p.doors && p.kind === 'district';
const genitive = (n: string) => n.replace(/ий район$/, 'ого района').replace(/ой район$/, 'ого района');

const h1 = {
  district: `Аварийное вскрытие замков ${p.loc}`,
  micro: `Вскрытие дверей и замков ${p.loc}`,
  suburb: `Аварийное вскрытие замков ${p.loc}`,
  city: `Вскрытие замков ${p.loc}`,
  raion: `Вскрытие замков ${p.loc} Киевской области`,
  group: `Вскрытие замков ${p.loc}`,
}[p.kind];
const crumbs = isKyiv
  ? [{ name: 'Районы Киева', href: '/kyiv/' }, ...(parent ? [{ name: parent.name, href: placeUrl(parent) }] : []), { name: p.name, href: url }]
  : [{ name: 'Киевская область', href: '/kyivska-oblast/' }, ...(parent ? [{ name: parent.name, href: placeUrl(parent) }] : []), { name: p.name, href: url }];

const lead = `${p.intro} Выезд ${p.loc} — <strong>${p.eta}</strong>, круглосуточно.`;

// Вариативные абзацы — разные формулировки на разных страницах
const svcIntro = vary(p.slug, [
  `${p.loc[0].toUpperCase() + p.loc.slice(1)} мы выполняем полный спектр работ с замками: от срочного вскрытия двери до изготовления ключа зажигания с чипом.`,
  `Мастера KyivLock, которые работают ${p.loc}, возят с собой инструмент для неразрушающего вскрытия, запас популярных личинок и заготовок ключей.`,
  `Ниже — услуги, которые чаще всего заказывают ${p.loc}. Цены указаны ориентировочно; окончательную стоимость мастер назовёт на месте до начала работ.`,
]);
const issueTail = vary(p.slug + 'i', [
  'Самое важное в таких ситуациях — не пытаться открыть замок силой: сломанный ключ или выбитая дверь обходятся гораздо дороже вызова мастера.',
  'Почти все такие случаи решаются без повреждений — при условии, что до приезда мастера замок не пытались «раскрутить» отвёрткой или плоскогубцами.',
  'Совет от наших мастеров: раз в год смазывайте цилиндр специальной смазкой и не пользуйтесь погнутым ключом — это предотвращает большинство аварийных вызовов.',
]);
const Loc = p.loc[0].toUpperCase() + p.loc.slice(1);
const nearNames = near.map((n) => n.name).slice(0, 3).join(', ');

// Короткое описание работы вместо общего блока «4 шага» — формулировки разные, подставлены факты локации.
const how = vary(p.slug + 'h', [
  `${Loc} схема простая: вы звоните и описываете дверь или авто, диспетчер сразу называет ориентировочную цену, а мастер выезжает из ближайшей точки — обычно это ${p.eta}. На месте он проверяет документы, называет фиксированную цену и только тогда приступает к работе.`,
  `Когда нам звонят ${p.loc}, мы передаём вызов мастеру, который сейчас ближе всего${nearNames ? ` — часто он только что закончил вызов в соседних локациях (${nearNames})` : ''}. Цену вы слышите ещё по телефону, окончательную — после осмотра замка, до начала работ.`,
  `Наш подход ${p.loc} ничем не отличается от центра Киева: честное время приезда (${p.eta}), проверка права на жильё или авто, фиксированная стоимость до начала работ. Разница лишь в маршруте мастера${p.streets[0] ? ` — чаще всего он заезжает через ${p.streets[0]}` : ''}.`,
]);
// Абзац «как добираемся» — собирается из данных (дороги, расстояние, метро, родительский район)
const route = p.kind === 'micro'
  ? `${p.name} входит в состав ${parent ? genitive(parent.name) : 'города'}${p.metro?.length ? `; рядом метро ${p.metro.join(', ')}` : ''}. Мастера хорошо знают местные дворы${p.streets.length > 1 ? ` — ${p.streets.slice(0, 4).join(', ')}` : ''}, поэтому не тратят время на поиск подъезда.`
  : p.kind === 'district'
    ? `${p.name} включает ${p.micros?.length ?? 0} жилых массивов и местностей${p.metro?.length ? `, здесь ${p.metro.length} станций метро (${p.metro.slice(0, 4).join(', ')})` : ''}. Мы распределяем вызовы между мастерами так, чтобы в любую точку района доезжать за ${p.eta}.`
    : `${p.distance ? `${p.name} — ${p.distance}. ` : ''}Мастер едет ${p.streets.length ? `через ${p.streets.slice(0, 2).join(' и ')}` : 'кратчайшим маршрутом'}; реальное время — ${p.eta}${p.surcharge ? `, ${p.surcharge}` : ''}.`;

const faq = [
  ...(p.faq ?? []),
  { q: `Как быстро приедет мастер ${p.loc}?`, a: `${vary(p.slug + 'f', ['Ориентировочно', 'Обычно', 'В среднем'])} ${p.eta}. ${p.distance ? `Расстояние — ${p.distance}. ` : ''}Точное время диспетчер назовёт с учётом трафика.` },
  { q: `Сколько стоит открыть дверь ${p.loc}?`, a: `Простой цилиндр — ${fmt(price('door-simple'))}, бронированная дверь — ${fmt(price('door-armored'))}.${p.surcharge ? ` Выезд: ${p.surcharge}.` : ` Вызов мастера по Киеву — ${fmt(price('call-kyiv'))}.`}` },
];
const schema = [faqPage(faq), svcSchema({ name: `Аварийное вскрытие замков — ${p.name}`, type: 'Аварийное вскрытие замков', path: url, description: p.intro, area: p.name, priceIds: ['door-simple', 'door-armored', 'car-open', 'safe-open', 'cyl-replace', 'ign-repair'] })];
const otherDistricts = DISTRICTS.filter((d) => d.slug !== p.slug && !near.includes(d));
const mainSvcs = SERVICES.slice(0, 6);
---
<Base title={placeTitle(p)} description={placeDesc(p)} path={url} crumbs={crumbs} schema={schema}>
  <Hero h1={h1} lead={lead} place={isKyiv ? (p.kind === 'micro' ? p.parent : p.slug) : p.slug} badges={['Круглосуточно, 24/7', `Выезд ${p.eta}`, 'Без повреждений', `От ${PRICE_FROM} грн`]} />

  <section class="section soft"><div class="wrap prose">
    <h2>Как мы работаем {p.loc}</h2>
    <p>{how}</p>
    <p>{route}</p>
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Услуги {p.loc} и цены</h2>
    <p>{svcIntro}</p>
    <div class="grid g3">
      {mainSvcs.map((s) => (
        <a class="card" href={hasDoor && s.slug === 'vidkryttia-dverey' ? comboUrl(p, DOOR_COMBO) : s.path}>
          <Icon name={s.icon} /><h3>{s.short}</h3>
        </a>
      ))}
      <a class="card" href={hasIgn ? comboUrl(p, IGN_COMBO) : IGN}><Icon name="ignition" /><h3>Ключи и замок зажигания</h3></a>
    </div>
    <div style="margin-top:20px"><W type="prices" ids={isKyiv ? ['door-simple', 'door-armored', 'car-open', 'cyl-replace'] : ['call-oblast', 'door-simple', 'car-open', 'ign-repair']} caption={`Ориентировочные цены ${p.loc}`} /></div>
  </div></section>

  <section class="section soft"><div class="wrap prose">
    <h2>Особенности застройки и замков {p.loc}</h2>
    <p>{p.housing}</p>
    {p.doors && <p>{p.doors}</p>}
    <h2>Типичные обращения {p.loc}</h2>
    <p>{p.issues} {issueTail}</p>
    {LOCAL[p.slug] && <><h3>Что стоит знать</h3><p>{LOCAL[p.slug]}</p></>}
    {TIPS[p.slug] && <><h3>Совет перед вызовом</h3><p>{TIPS[p.slug]}</p></>}
    <h2>Ключи зажигания и замки авто {p.loc}</h2>
    {p.ignition ? <p>{p.ignition}</p> : vary(p.slug + 'g', [
      <p>Кроме дверей, мы помогаем водителям {p.loc}: <a href={IGN + 'kliuch-ne-povertaietsia/'}>ключ не поворачивается в замке зажигания</a>, <a href={IGN + 'zlamanyi-kliuch/'}>сломался ключ</a>, нужен <a href={IGN + 'kliuch-z-chipom-imobilayzer/'}>ключ с чипом</a>. Большинство работ — на месте, где стоит авто.</p>,
      <p>Если проблема не с дверью, а с машиной, — мастер приедет и к авто: <a href={IGN + 'remont-zamka-zapaliuvannia/'}>отремонтирует замок зажигания</a>, <a href={IGN + 'vyhotovlennia-kliucha/'}>изготовит запасной ключ</a> или <a href={IGN + 'smart-kliuch/'}>разберётся со смарт-ключом</a>.</p>,
      <p>Водителям {p.loc} мы чаще всего помогаем с тремя вещами: <a href={IGN + 'zlamanyi-kliuch/'}>обломок ключа в замке</a>, <a href={IGN + 'vtracheni-vsi-kliuchi/'}>потеряны все ключи</a> и <a href={IGN + 'kliuch-z-chipom-imobilayzer/'}>авто не видит чип</a>. Эвакуатор обычно не нужен.</p>,
    ])}
    <p>{hasIgn ? <a href={comboUrl(p, IGN_COMBO)}>Ремонт замка зажигания {p.loc} — подробнее</a> : <a href={IGN}>Все услуги с ключами зажигания</a>}</p>
  </div></section>

  <section class="section"><div class="wrap">
    <h2>{p.kind === 'raion' ? 'Города и сёла района, которые мы обслуживаем' : p.kind === 'group' ? 'Сёла, которые мы обслуживаем' : `Улицы, ориентиры и микрорайоны ${p.loc}`}</h2>
    {microLinks.length > 0 && (
      <ul class="cols c3">{microLinks.map((m) => <li>{m.href ? <a href={m.href}><b>{m.name}</b></a> : <b>{m.name}</b>} — {m.note}</li>)}</ul>
    )}
    {kids.length > 0 && <W type="links" links={kids.filter((k) => !microLinks.some((m) => m.slug === k.slug)).map((k) => ({ href: placeUrl(k), name: k.name }))} />}
    {p.metro && p.metro.length > 0 && <p><strong>Метро рядом:</strong> {p.metro.join(', ')}.</p>}
    <p><strong>{p.kind === 'raion' || p.kind === 'group' ? 'Основные дороги' : 'Улицы, где мы часто работаем'}:</strong> {p.streets.join(', ')}.</p>
    <p><strong>Ориентиры:</strong> {p.landmarks.join(', ')}.</p>
    <p class="note" style="margin-top:16px">{vary(p.slug + 'o', [
      `Мы вскрываем двери ${p.loc} только владельцам и жильцам: проверяем паспорт с регистрацией или договор аренды, для авто — техпаспорт.`,
      `Безопасность важнее скорости: без документа, подтверждающего ваше право на жильё или авто, мастер не вскрывает замок — даже ${p.loc}.`,
      `Документы проверяем всегда. Если они остались внутри — вскрываем и сверяем сразу после вскрытия, в присутствии соседей.`,
    ])} <a href="/pro-nas/">Наши принципы</a>.</p>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Отзывы клиентов {p.loc}</h2>
    <W type="reviews" place={p.slug} />
  </div></section>

  <section class="section"><div class="wrap two">
    <div><h2>Вопросы и ответы: {p.short}</h2><W type="faq" items={faq} /></div>
    <div><LeadForm place={p.slug} uid="bottom" title={`Вызов мастера ${p.loc}`} /></div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>{isKyiv ? 'Соседние районы и массивы' : 'Рядом также обслуживаем'}</h2>
    <W type="links" links={[...(parent ? [{ href: placeUrl(parent), name: parent.name }] : []), ...near.map((n) => ({ href: placeUrl(n), name: `Вскрытие замков ${n.loc}` }))]} />
    {hasDoor && <p><a href={comboUrl(p, DOOR_COMBO)}>Вскрытие дверей {p.loc}</a></p>}
    {isKyiv && <><h2 style="margin-top:24px">Другие районы Киева</h2>
    <W type="links" links={otherDistricts.map((d) => ({ href: placeUrl(d), name: d.name }))} /></>}
  </div></section>
</Base>
