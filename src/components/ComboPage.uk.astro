---
// Комбіновані сторінки «послуга + локація»: ключі запалювання (5А.4) і відкриття дверей (2.2).
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Blocks from './Blocks.astro';
import W from './Widgets.astro';
import LeadForm from './LeadForm.astro';
import type { Place } from '../data/kyiv';
import { IGN } from '../data/services';
import { IGN_PAGES, IGN_FAQ, SITUATIONS } from '../data/ignition';
import { BUSINESS } from '../data/business';
import { price, fmt } from '../data/prices';
import { comboIgnTitle, comboIgnDesc, comboDoorTitle, comboDoorDesc } from '../lib/seo';
import { faqPage, service } from '../lib/schema';
import { place, placeUrl, comboUrl, neighbors, IGN_COMBO, DOOR_COMBO, ignitionCombos, doorCombos } from '../lib/site';

interface Props { p: Place; kind: 'ign' | 'door' }
const { p, kind } = Astro.props;
const ign = kind === 'ign';
const isKyiv = p.kind === 'district';
const url = comboUrl(p, ign ? IGN_COMBO : DOOR_COMBO);
const parent = p.parent ? place(p.parent) : undefined;
const hub = isKyiv ? { name: 'Райони Києва', href: '/kyiv/' } : { name: 'Київська область', href: '/kyivska-oblast/' };
const label = ign ? 'Ключі запалювання' : 'Відкриття дверей';
const crumbs = [hub, ...(parent && !isKyiv ? [{ name: parent.name, href: placeUrl(parent) }] : []), { name: p.name, href: placeUrl(p) }, { name: label, href: url }];
const others = (ign ? ignitionCombos : doorCombos).filter((x) => x.slug !== p.slug);
const nearCombos = neighbors(p).filter((n) => others.includes(n));

const h1 = ign ? `Ремонт замка запалювання та ключі ${p.loc}` : `Відкриття дверей ${p.loc} без пошкоджень`;
const lead = ign
  ? `Ключ не повертається, застряг чи зламався, потрібен ключ з чіпом або смарт-ключ? Приїдемо ${p.loc} за ${p.eta} і відремонтуємо замок запалювання на місці — у дворі, на парковці чи біля роботи.`
  : `Захлопнулися двері, зламався ключ або заклинив замок? Майстер приїде ${p.loc} за ${p.eta}, перевірить документи й відкриє двері неруйнівним методом.`;
const faq = ign
  ? [
      { q: `Чи ремонтуєте замок запалювання ${p.loc} на місці?`, a: `Так, більшість робіт — ремонт і заміну личинки, витяг уламка ключа, виготовлення ключа з чіпом — виконуємо ${p.loc} на місці. Складні випадки — у майстерні.` },
      { q: `Скільки чекати майстра ${p.loc}?`, a: `Орієнтовно ${p.eta}. Щоб майстер взяв потрібні деталі, назвіть марку, модель і рік авто.` },
      ...IGN_FAQ.slice(0, 7),
    ]
  : [
      { q: `Скільки коштує відкриття дверей ${p.loc}?`, a: `Простий циліндр — ${fmt(price('door-simple'))}, сувальдний або підвищеної секретності — ${fmt(price('door-complex'))}, броньовані двері — ${fmt(price('door-armored'))}, тамбурні — ${fmt(price('door-tambour'))}.` },
      { q: `Як швидко приїде майстер ${p.loc}?`, a: `Зазвичай ${p.eta}; точний час назве диспетчер.` },
      { q: 'Чи відкриєте двері без пошкоджень?', a: 'У понад 90% випадків — так. Висвердлювання — лише за вашою згодою, з одразу встановленою новою личинкою.' },
      { q: 'Що робити, якщо документи залишились усередині?', a: 'Ми відкриємо двері й перевіримо документи одразу після відкриття в присутності сусідів.' },
      { q: 'Чи міняєте замок після відкриття?', a: 'Так, якщо ключі загублені чи замок пошкоджений — замінимо личинку або замок на місці.' },
    ];
const schema = [
  service(ign
    ? { name: `Ремонт замка запалювання — ${p.name}`, type: 'Ремонт замка запалювання', path: url, description: lead, area: p.name, priceIds: ['ign-diag', 'ign-repair', 'ign-cyl', 'ign-broken', 'ign-key-chip', 'ign-key-smart', 'ign-all-lost'] }
    : { name: `Відкриття дверей — ${p.name}`, type: 'Аварійне відкриття дверей', path: url, description: lead, area: p.name, priceIds: ['door-simple', 'door-complex', 'door-armored', 'door-tambour', 'door-destructive'] }),
  faqPage(faq),
];
---
<Base title={ign ? comboIgnTitle(p) : comboDoorTitle(p)} description={ign ? comboIgnDesc(p) : comboDoorDesc(p)} path={url} crumbs={crumbs} schema={schema}>
  <Hero h1={h1} lead={lead} variant={ign ? 'ignition' : 'default'} place={p.slug} badges={ign ? ['Виїзд до авто', `${p.eta}`, 'Гарантія на роботи', 'Перевірка документів'] : ['Цілодобово', `${p.eta}`, 'Без пошкоджень', 'Ціна до початку робіт']} />
  {ign ? (
    <>
      <section class="section"><div class="wrap prose">
        <h2>Ключі та замки запалювання {p.loc}: з чим звертаються</h2>
        <p>{p.ignition}</p>
        <p>{p.issues}</p>
        <h2>Де ми працюємо і де майстерня</h2>
        <p>Майстер виїжджає {p.loc} з набором личинок, заготовок ключів і програматором — більшість ремонтів виконуємо прямо біля вашого авто{p.streets.length ? `, зокрема на ${p.streets.slice(0, 3).join(', ')}` : ''}. Для складних робіт (заміна замка керма, програмування блоків, All keys lost на преміальних марках) авто приймаємо в майстерні{BUSINESS.workshopAddress && <> за адресою <strong>{BUSINESS.workshopAddress}</strong></>}; за потреби організуємо евакуатор{p.distance ? ` (відстань: ${p.distance})` : ''}.</p>
        <h2>Що ми робимо {p.loc}</h2>
        <ul class="cols">{IGN_PAGES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul>
      </div></section>
      <section class="section soft"><div class="wrap">
        <h2>Ваша ситуація і орієнтовна ціна</h2>
        <div class="tbl"><table>
          <thead><tr><th scope="col">Ситуація</th><th scope="col">Час</th><th scope="col">Ціна від</th></tr></thead>
          <tbody>{SITUATIONS.slice(0, 10).map((s) => <tr><td>{s.s}</td><td>{s.t}</td><td class="p">{fmt(price(s.p))}</td></tr>)}</tbody>
        </table></div>
        <W type="prices" ids={[]} />
      </div></section>
      <Blocks type="steps-ign" />
      <Blocks type="ign-wait" />
      <Blocks type="ownership-car" seed={p.slug + 'c'} />
      <Blocks type="guarantee" />
    </>
  ) : (
    <>
      <section class="section"><div class="wrap prose">
        <h2>Двері та замки {p.loc}</h2>
        <p>{p.doors}</p>
        <p>{p.housing}</p>
        <h2>Як ми відкриваємо різні двері</h2>
        <ul>
          <li><strong>Циліндрові замки</strong> — натяжні планки та відмички, 5–15 хвилин для стандартних циліндрів.</li>
          <li><strong>Сувальдні замки</strong> — декодування через замкову щілину без пошкоджень.</li>
          <li><strong>Броньовані двері</strong> (Mul-T-Lock, Cisa, Abloy, Securemme, Gerda) — спеціальний інструмент і досвід.</li>
          <li><strong>Тамбурні двері</strong> — швидке відкриття, за потреби заміна циліндра.</li>
          <li><strong>Електронні замки</strong> — аварійний циліндр або зовнішнє живлення.</li>
        </ul>
        <p>Детальніше — на сторінці <a href="/poslugy/vidkryttia-dverey/">аварійне відкриття дверей у Києві</a>.</p>
        {p.micros && <><h2>Масиви та мікрорайони, де ми відкриваємо двері</h2><ul class="cols">{p.micros.map((m) => <li>{m.slug && place(m.slug) ? <a href={placeUrl(place(m.slug)!)}>{m.name}</a> : m.name} — {m.note}</li>)}</ul></>}
      </div></section>
      <section class="section soft"><div class="wrap">
        <h2>Ціни на відкриття дверей {p.loc}</h2>
        <W type="prices" ids={['door-simple', 'door-complex', 'door-armored', 'door-tambour', 'door-destructive', 'door-child', 'cyl-replace']} />
      </div></section>
      <Blocks type="steps" seed={p.slug + 'd'} where={p.loc} />
      <Blocks type="ownership" seed={p.slug + 'd'} />
    </>
  )}
  <section class="section soft"><div class="wrap">
    <h2>Відгуки</h2>
    <W type="reviews" place={p.slug} service={ign ? IGN : '/poslugy/vidkryttia-dverey/'} />
  </div></section>
  <section class="section"><div class="wrap two">
    <div><h2>Питання і відповіді</h2><W type="faq" items={faq} /></div>
    <div><LeadForm variant={ign ? 'ignition' : 'default'} place={p.slug} uid="bottom" title={`${label} ${p.loc}`} /></div>
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Усі послуги {p.loc}</h2>
    <p><a href={placeUrl(p)}>Аварійне відкриття замків {p.loc}</a> · <a href={ign ? IGN : '/poslugy/vidkryttia-dverey/'}>{ign ? 'Усі послуги з ключами запалювання' : 'Відкриття дверей у Києві'}</a></p>
    <h2 style="margin-top:24px">{label} в інших районах</h2>
    <W type="links" links={[...nearCombos, ...others.filter((o) => !nearCombos.includes(o))].map((o) => ({ href: comboUrl(o, ign ? IGN_COMBO : DOOR_COMBO), name: `${label} ${o.loc}` }))} />
  </div></section>
</Base>
