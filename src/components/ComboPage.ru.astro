---
// Русская версия комбинированных страниц «услуга + локация»: ключи зажигания и вскрытие дверей (см. ComboPage.uk.astro).
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Blocks from './Blocks.astro';
import W from './Widgets.astro';
import LeadForm from './LeadForm.astro';
import type { Place } from '../data/kyiv';
import { IGN } from '../data/services';
import { IGN_PAGES, IGN_FAQ, SITUATIONS } from '../data/ignition';
import { BUSINESS } from '../data/business';
import { price, fmt } from '../data/prices';
import { comboIgnTitle, comboIgnDesc, comboDoorTitle, comboDoorDesc } from '../lib/seo';
import { faqPage, service } from '../lib/schema';
import { place, placeUrl, comboUrl, neighbors, IGN_COMBO, DOOR_COMBO, ignitionCombos, doorCombos } from '../lib/site';

interface Props { p: Place; kind: 'ign' | 'door' }
const { p, kind } = Astro.props;
const ign = kind === 'ign';
const isKyiv = p.kind === 'district';
const url = comboUrl(p, ign ? IGN_COMBO : DOOR_COMBO);
const parent = p.parent ? place(p.parent) : undefined;
const hub = isKyiv ? { name: 'Районы Киева', href: '/kyiv/' } : { name: 'Киевская область', href: '/kyivska-oblast/' };
const label = ign ? 'Ключи зажигания' : 'Вскрытие дверей';
const crumbs = [hub, ...(parent && !isKyiv ? [{ name: parent.name, href: placeUrl(parent) }] : []), { name: p.name, href: placeUrl(p) }, { name: label, href: url }];
const others = (ign ? ignitionCombos : doorCombos).filter((x) => x.slug !== p.slug);
const nearCombos = neighbors(p).filter((n) => others.includes(n));

const h1 = ign ? `Ремонт замка зажигания и ключи ${p.loc}` : `Вскрытие дверей ${p.loc} без повреждений`;
const lead = ign
  ? `Ключ не поворачивается, застрял или сломался, нужен ключ с чипом или смарт-ключ? Приедем ${p.loc} за ${p.eta} и отремонтируем замок зажигания на месте — во дворе, на парковке или у работы.`
  : `Захлопнулась дверь, сломался ключ или заклинил замок? Мастер приедет ${p.loc} за ${p.eta}, проверит документы и откроет дверь неразрушающим методом.`;
const faq = ign
  ? [
      { q: `Ремонтируете замок зажигания ${p.loc} на месте?`, a: `Да, большинство работ — ремонт и замену личинки, извлечение обломка ключа, изготовление ключа с чипом — выполняем ${p.loc} на месте. Сложные случаи — в мастерской.` },
      { q: `Сколько ждать мастера ${p.loc}?`, a: `Ориентировочно ${p.eta}. Чтобы мастер взял нужные детали, назовите марку, модель и год авто.` },
      ...IGN_FAQ.slice(0, 7),
    ]
  : [
      { q: `Сколько стоит вскрытие двери ${p.loc}?`, a: `Простой цилиндр — ${fmt(price('door-simple'))}, сувальдный или повышенной секретности — ${fmt(price('door-complex'))}, бронированная дверь — ${fmt(price('door-armored'))}, тамбурная — ${fmt(price('door-tambour'))}.` },
      { q: `Как быстро приедет мастер ${p.loc}?`, a: `Обычно ${p.eta}; точное время назовёт диспетчер.` },
      { q: 'Откроете дверь без повреждений?', a: 'В более чем 90% случаев — да. Высверливание — только с вашего согласия, со сразу установленной новой личинкой.' },
      { q: 'Что делать, если документы остались внутри?', a: 'Мы откроем дверь и проверим документы сразу после вскрытия в присутствии соседей.' },
      { q: 'Меняете замок после вскрытия?', a: 'Да, если ключи утеряны или замок повреждён — заменим личинку или замок на месте.' },
    ];
const schema = [
  service(ign
    ? { name: `Ремонт замка зажигания — ${p.name}`, type: 'Ремонт замка зажигания', path: url, description: lead, area: p.name, priceIds: ['ign-diag', 'ign-repair', 'ign-cyl', 'ign-broken', 'ign-key-chip', 'ign-key-smart', 'ign-all-lost'] }
    : { name: `Вскрытие дверей — ${p.name}`, type: 'Аварийное вскрытие дверей', path: url, description: lead, area: p.name, priceIds: ['door-simple', 'door-complex', 'door-armored', 'door-tambour', 'door-destructive'] }),
  faqPage(faq),
];
---
<Base title={ign ? comboIgnTitle(p) : comboDoorTitle(p)} description={ign ? comboIgnDesc(p) : comboDoorDesc(p)} path={url} crumbs={crumbs} schema={schema}>
  <Hero h1={h1} lead={lead} variant={ign ? 'ignition' : 'default'} place={p.slug} badges={ign ? ['Выезд к авто', `${p.eta}`, 'Гарантия на работы', 'Проверка документов'] : ['Круглосуточно', `${p.eta}`, 'Без повреждений', 'Цена до начала работ']} />
  {ign ? (
    <>
      <section class="section"><div class="wrap prose">
        <h2>Ключи и замки зажигания {p.loc}: с чем обращаются</h2>
        <p>{p.ignition}</p>
        <p>{p.issues}</p>
        <h2>Где мы работаем и где мастерская</h2>
        <p>Мастер выезжает {p.loc} с набором личинок, заготовок ключей и программатором — большинство ремонтов выполняем прямо возле вашего авто{p.streets.length ? `, в том числе на ${p.streets.slice(0, 3).join(', ')}` : ''}. Для сложных работ (замена замка руля, программирование блоков, All keys lost на премиальных марках) авто принимаем в мастерской{BUSINESS.workshopAddress && <> по адресу <strong>{BUSINESS.workshopAddress}</strong></>}; при необходимости организуем эвакуатор{p.distance ? ` (расстояние: ${p.distance})` : ''}.</p>
        <h2>Что мы делаем {p.loc}</h2>
        <ul class="cols">{IGN_PAGES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul>
      </div></section>
      <section class="section soft"><div class="wrap">
        <h2>Ваша ситуация и ориентировочная цена</h2>
        <div class="tbl"><table>
          <thead><tr><th scope="col">Ситуация</th><th scope="col">Время</th><th scope="col">Цена от</th></tr></thead>
          <tbody>{SITUATIONS.slice(0, 10).map((s) => <tr><td>{s.s}</td><td>{s.t}</td><td class="p">{fmt(price(s.p))}</td></tr>)}</tbody>
        </table></div>
        <W type="prices" ids={[]} />
      </div></section>
      <Blocks type="steps-ign" />
      <Blocks type="ign-wait" />
      <Blocks type="ownership-car" seed={p.slug + 'c'} />
      <Blocks type="guarantee" />
    </>
  ) : (
    <>
      <section class="section"><div class="wrap prose">
        <h2>Двери и замки {p.loc}</h2>
        <p>{p.doors}</p>
        <p>{p.housing}</p>
        <h2>Как мы вскрываем разные двери</h2>
        <ul>
          <li><strong>Цилиндровые замки</strong> — натяжные планки и отмычки, 5–15 минут для стандартных цилиндров.</li>
          <li><strong>Сувальдные замки</strong> — декодирование через замочную скважину без повреждений.</li>
          <li><strong>Бронированные двери</strong> (Mul-T-Lock, Cisa, Abloy, Securemme, Gerda) — специальный инструмент и опыт.</li>
          <li><strong>Тамбурные двери</strong> — быстрое вскрытие, при необходимости замена цилиндра.</li>
          <li><strong>Электронные замки</strong> — аварийный цилиндр или внешнее питание.</li>
        </ul>
        <p>Подробнее — на странице <a href="/poslugy/vidkryttia-dverey/">аварийное вскрытие дверей в Киеве</a>.</p>
        {p.micros && <><h2>Массивы и микрорайоны, где мы вскрываем двери</h2><ul class="cols">{p.micros.map((m) => <li>{m.slug && place(m.slug) ? <a href={placeUrl(place(m.slug)!)}>{m.name}</a> : m.name} — {m.note}</li>)}</ul></>}
      </div></section>
      <section class="section soft"><div class="wrap">
        <h2>Цены на вскрытие дверей {p.loc}</h2>
        <W type="prices" ids={['door-simple', 'door-complex', 'door-armored', 'door-tambour', 'door-destructive', 'door-child', 'cyl-replace']} />
      </div></section>
      <Blocks type="steps" seed={p.slug + 'd'} where={p.loc} />
      <Blocks type="ownership" seed={p.slug + 'd'} />
    </>
  )}
  <section class="section soft"><div class="wrap">
    <h2>Отзывы</h2>
    <W type="reviews" place={p.slug} service={ign ? IGN : '/poslugy/vidkryttia-dverey/'} />
  </div></section>
  <section class="section"><div class="wrap two">
    <div><h2>Вопросы и ответы</h2><W type="faq" items={faq} /></div>
    <div><LeadForm variant={ign ? 'ignition' : 'default'} place={p.slug} uid="bottom" title={`${label} ${p.loc}`} /></div>
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Все услуги {p.loc}</h2>
    <p><a href={placeUrl(p)}>Аварийное вскрытие замков {p.loc}</a> · <a href={ign ? IGN : '/poslugy/vidkryttia-dverey/'}>{ign ? 'Все услуги с ключами зажигания' : 'Вскрытие дверей в Киеве'}</a></p>
    <h2 style="margin-top:24px">{label} в других районах</h2>
    <W type="links" links={[...nearCombos, ...others.filter((o) => !nearCombos.includes(o))].map((o) => ({ href: comboUrl(o, ign ? IGN_COMBO : DOOR_COMBO), name: `${label} ${o.loc}` }))} />
  </div></section>
</Base>
