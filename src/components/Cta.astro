---
// Кнопки дзвінка та месенджерів. data-ga — події GA4 (див. Base.astro).
import Icon from './Icon.astro';
import { BUSINESS, links } from '../data/business';
import { t } from '../i18n/ctx';
interface Props { dark?: boolean; compact?: boolean }
const { dark = false, compact = false } = Astro.props;
---
<div class="ctas">
  <a class="btn btn-call" href={links.phone} data-ga="phone_click"><Icon name="phone" class="" /> {t('Подзвонити', 'Позвонить')} {compact ? '' : BUSINESS.phone}</a>
  {BUSINESS.telegram && <a class="btn btn-tg" href={links.telegram} data-ga="messenger_click" data-ch="telegram" rel="noopener" target="_blank"><Icon name="telegram" class="" /> Telegram</a>}
  {BUSINESS.viber && <a class="btn btn-vb" href={links.viber} data-ga="messenger_click" data-ch="viber"><Icon name="viber" class="" /> Viber</a>}
  {!compact && BUSINESS.whatsapp && <a class="btn btn-wa" href={links.whatsapp} data-ga="messenger_click" data-ch="whatsapp" rel="noopener" target="_blank"><Icon name="whatsapp" class="" /> WhatsApp</a>}
</div>
