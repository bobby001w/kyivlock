---
// Блок виклику майстра: лише номер телефону та кнопка дзвінка (замість форми зворотного дзвінка).
// Ім'я компонента збережено, щоб не змінювати всі сторінки, де він використовується.
import Icon from './Icon.astro';
import { BUSINESS, links } from '../data/business';
import { t } from '../i18n/ctx';
interface Props { variant?: 'default' | 'ignition'; place?: string; title?: string; uid?: string }
const { variant = 'default', title = t('Виклик майстра 24/7', 'Вызов мастера 24/7'), uid = 'f' } = Astro.props;
const ign = variant === 'ignition';
---
<aside class="callcard" aria-labelledby={`${uid}-h`}>
  <p class="eyebrow">{t('Цілодобово · Київ і область', 'Круглосуточно · Киев и область')}</p>
  <p class="h" id={`${uid}-h`}>{title}</p>
  <p class="muted">{ign ? t('Назвіть марку, модель і рік авто — майстер одразу скаже ціну та строки.', 'Назовите марку, модель и год авто — мастер сразу скажет цену и сроки.') : t('Опишіть ситуацію — диспетчер одразу назве ціну та час приїзду.', 'Опишите ситуацию — диспетчер сразу назовёт цену и время приезда.')}</p>
  <a class="callcard-num" href={links.phone} data-ga="phone_click">{BUSINESS.phone}</a>
  <a class="btn btn-call" href={links.phone} data-ga="phone_click"><Icon name="phone" class="" /> {t('Зателефонувати', 'Позвонить')}</a>
  <ul class="callcard-list">
    <li>{t('Ціна — до початку робіт', 'Цена — до начала работ')}</li>
    <li>{t('Без пошкоджень дверей і авто', 'Без повреждений дверей и авто')}</li>
    <li>{t('Гарантія на роботи', 'Гарантия на работы')}</li>
  </ul>
</aside>
