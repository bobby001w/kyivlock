---
// Меню — чисті HTML-посилання (працює без JS): desktop — випадаючі списки на :hover/:focus-within,
// mobile — <details>. Усі послуги, райони й міста — максимум 2 кліки від будь-якої сторінки.
// Перемикач мови веде на ту саму сторінку іншою мовою (data-keep — щоб middleware не додав /ru/).
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { BUSINESS, links } from '../data/business';
import { SERVICES, IGN } from '../data/services';
import { IGN_PAGES } from '../data/ignition';
import { DISTRICTS } from '../data/kyiv';
import { RAIONS } from '../data/oblast';
import { TOP_CITIES, placeUrl } from '../lib/site';
import { lang, t, basePath, localePath } from '../i18n/ctx';
interface Props { noSwitch?: boolean } // noindex-сторінки (404) не мають мовної пари
const { noSwitch = false } = Astro.props;
const l = lang();
const svc = [...SERVICES.slice(0, 2), { path: IGN, short: t('Ключі запалювання', 'Ключи зажигания') }, ...SERVICES.slice(2)];
const here = basePath(Astro.url.pathname);
---
<div class="top"><div class="wrap">
  <span class="top-l">{t('Цілодобово, 24/7 · Київ і Київська область', 'Круглосуточно, 24/7 · Киев и Киевская область')}</span>
  <span class="top-r">
    {!noSwitch && <span class="lang-sw" aria-label={t('Мова сайту', 'Язык сайта')}>
      {l === 'uk' ? <b aria-current="true">UA</b> : <a data-keep href={localePath(here, 'uk')} hreflang="uk" lang="uk">UA</a>}
      {l === 'ru' ? <b aria-current="true">RU</b> : <a data-keep href={localePath(here, 'ru')} hreflang="ru" lang="ru">RU</a>}
    </span>}
    <a href={links.phone} data-ga="phone_click">{BUSINESS.phone}</a>
  </span>
</div></div>
<header class="hdr">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label={t('Головне меню', 'Главное меню')}>
      <div class="dd"><a href="/poslugy/">{t('Послуги', 'Услуги')}</a>
        <div class="dd-panel">{svc.map((s) => <a href={s.path}>{s.short}</a>)}</div></div>
      <div class="dd"><a href={IGN}>{t('Ключі запалювання', 'Ключи зажигания')}</a>
        <div class="dd-panel">{IGN_PAGES.map((s) => <a href={s.path}>{s.short}</a>)}<a href={IGN + 'marky/'}>{t('Ключі за марками авто', 'Ключи по маркам авто')}</a></div></div>
      <div class="dd"><a href="/kyiv/">{t('Райони Києва', 'Районы Киева')}</a>
        <div class="dd-panel wide">{DISTRICTS.map((d) => <a href={placeUrl(d)}>{d.name}</a>)}<a href="/kyiv/">{t('Усі райони і масиви', 'Все районы и массивы')}</a></div></div>
      <div class="dd"><a href="/kyivska-oblast/">{t('Київська область', 'Киевская область')}</a>
        <div class="dd-panel wide">{TOP_CITIES.map((c) => <a href={placeUrl(c)}>{c.name}</a>)}{RAIONS.map((r) => <a href={placeUrl(r)}>{r.name}</a>)}</div></div>
      <a href="/tsiny/">{t('Ціни', 'Цены')}</a>
      <a href="/vidhuky/">{t('Відгуки', 'Отзывы')}</a>
      <a href="/kontakty/">{t('Контакти', 'Контакты')}</a>
    </nav>
    <a class="hdr-phone" href={links.phone} data-ga="phone_click">{BUSINESS.phone}</a>
    <details class="menu-m">
      <summary aria-label={t('Відкрити меню', 'Открыть меню')}><Icon name="menu" class="" /></summary>
      <div class="menu-panel">
        {!noSwitch && <div class="menu-lang">{t('Мова', 'Язык')}: {l === 'uk' ? <b>Українська</b> : <a data-keep href={localePath(here, 'uk')} hreflang="uk" lang="uk">Українська</a>} · {l === 'ru' ? <b>Русский</b> : <a data-keep href={localePath(here, 'ru')} hreflang="ru" lang="ru">Русский</a>}</div>}
        <details><summary>{t('Послуги', 'Услуги')}</summary><a href="/poslugy/">{t('Усі послуги', 'Все услуги')}</a>{svc.map((s) => <a href={s.path}>{s.short}</a>)}</details>
        <details><summary>{t('Ключі запалювання', 'Ключи зажигания')}</summary><a href={IGN}>{t('Усі послуги з ключами', 'Все услуги с ключами')}</a>{IGN_PAGES.map((s) => <a href={s.path}>{s.short}</a>)}<a href={IGN + 'marky/'}>{t('За марками авто', 'По маркам авто')}</a></details>
        <details><summary>{t('Райони Києва', 'Районы Киева')}</summary><a href="/kyiv/">{t('Усі райони', 'Все районы')}</a>{DISTRICTS.map((d) => <a href={placeUrl(d)}>{d.name}</a>)}</details>
        <details><summary>{t('Київська область', 'Киевская область')}</summary><a href="/kyivska-oblast/">{t('Уся область', 'Вся область')}</a>{TOP_CITIES.map((c) => <a href={placeUrl(c)}>{c.name}</a>)}</details>
        <a href="/tsiny/">{t('Ціни', 'Цены')}</a><a href="/vidhuky/">{t('Відгуки', 'Отзывы')}</a><a href="/blog/">{t('Блог', 'Блог')}</a><a href="/faq/">{t('Питання і відповіді', 'Вопросы и ответы')}</a><a href="/pro-nas/">{t('Про нас', 'О нас')}</a><a href="/kontakty/">{t('Контакти', 'Контакты')}</a>
      </div>
    </details>
  </div>
</header>
