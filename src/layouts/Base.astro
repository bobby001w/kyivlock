---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BUSINESS } from '../data/business';
import { lang, t, basePath, localePath, LANGS } from '../i18n/ctx';
import { breadcrumbs as bcSchema, organization, clean, abs } from '../lib/schema';
import { fill } from '../lib/seo';

interface Props {
  title: string; description: string; path?: string; noindex?: boolean;
  crumbs?: { name: string; href: string }[]; schema?: unknown[];
  ogImage?: string; ogType?: string; preload?: string;
}
const { title, description, noindex = false, crumbs = [], schema = [], ogImage = '/images/og-kyivlock.jpg', ogType = 'website', preload } = Astro.props;
// Canonical — завжди абсолютний, самореферентний (у межах мови), без query-параметрів, нижній регістр.
// path передається без мовного префікса; для /ru/ префікс додається тут.
const l = lang();
const path = basePath((Astro.props.path ?? Astro.url.pathname).toLowerCase());
const canonical = abs(localePath(path, l));
const desc = fill(description);
const allCrumbs = crumbs.length ? [{ name: t('Головна', 'Главная'), href: '/' }, ...crumbs] : [];
const ld = [organization(), ...(allCrumbs.length ? [bcSchema(allCrumbs)] : []), ...schema];
// Google Analytics 4: ідентифікатор лише зі змінної середовища GA_ID (workflow). Немає змінної — тег не підключається.
const GA_ID = /^G-[A-Z0-9]+$/.test((process.env.GA_ID ?? '').trim()) ? process.env.GA_ID!.trim() : '';
---
<!doctype html>
<html lang={l}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fill(title)}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  {!noindex && LANGS.map((x) => <link rel="alternate" hreflang={x} href={abs(localePath(path, x))} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={abs(path)} />}
  <link rel="preload" href="/fonts/golos-cyrillic-700.woff2" as="font" type="font/woff2" crossorigin />
  {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
  <meta name="theme-color" content="#111318" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  {BUSINESS.gscVerification && <meta name="google-site-verification" content={BUSINESS.gscVerification} />}
  {BUSINESS.bingVerification && <meta name="msvalidate.01" content={BUSINESS.bingVerification} />}
  <meta name="format-detection" content="telephone=no" />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={t('uk_UA', 'ru_UA')} />
  <meta property="og:locale:alternate" content={t('ru_UA', 'uk_UA')} />
  <meta property="og:site_name" content="KyivLock" />
  <meta property="og:title" content={fill(title)} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={abs(ogImage)} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fill(title)} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={abs(ogImage)} />
  {ld.map((s) => <script type="application/ld+json" set:html={clean(s)} />)}
</head>
<body data-ga-id={GA_ID || undefined} data-lang={l}>
  <a class="skip" href="#main">{t('Перейти до змісту', 'Перейти к содержимому')}</a>
  <Header noSwitch={noindex} />
  {allCrumbs.length > 0 && <Breadcrumbs items={allCrumbs} />}
  <main id="main"><slot /></main>
  <Footer />
  <MobileBar />
  <div class="cookie" id="cookie" role="dialog" aria-live="polite" aria-label={t('Згода на cookie', 'Согласие на cookie')} hidden>
    {t('Ми використовуємо аналітичні cookie (Google Analytics), щоб покращувати сайт. Необхідні cookie працюють завжди.', 'Мы используем аналитические cookie (Google Analytics), чтобы улучшать сайт. Необходимые cookie работают всегда.')}
    <a href="/polityka-konfidentsiinosti/#cookie">{t('Детальніше', 'Подробнее')}</a>.
    <div class="ctas"><button class="btn btn-call" type="button" data-consent="granted">{t('Прийняти', 'Принять')}</button><button class="btn btn-line" type="button" data-consent="denied">{t('Лише необхідні', 'Только необходимые')}</button></div>
  </div>
  <script src="/js/main.js" defer></script>
</body>
</html>
