---
import Base from '../../../../layouts/Base.astro';
import Hero from '../../../../components/Hero.astro';
import { IGN } from '../../../../data/services';
import { BRANDS } from '../../../../data/brands';
import { brandUrl } from '../../../../lib/site';
const path = IGN + 'marky/';
---
<Base title="Ключі запалювання за марками авто — Київ | KyivLock" description="Ремонт замків запалювання та виготовлення ключів для Toyota, VW, Skoda, Ford, BMW, Mercedes, Hyundai, Kia та ін. Типові проблеми й ціни. Дзвоніть {PHONE}." path={path} crumbs={[{ name: 'Послуги', href: '/poslugy/' }, { name: 'Ключі запалювання', href: IGN }, { name: 'Марки авто', href: path }]}>
  <Hero h1="Ключі запалювання та замки за марками авто" lead="У кожної марки — свої типові «хвороби» замків запалювання, свої типи ключів та особливості імобілайзерів. Оберіть марку, щоб дізнатися, що ми робимо, скільки це триває і коштує." variant="ignition" />
  <section class="section"><div class="wrap">
    <h2>Оберіть марку</h2>
    <div class="grid g4">{BRANDS.map((b) => <a class="card" href={brandUrl(b.slug)}><h3>{b.name}</h3><p class="muted">{b.models.split(', ').slice(0, 4).join(', ')}</p></a>)}</div>
    <p class="muted" style="margin-top:16px">Не знайшли свою марку? Ми працюємо з більшістю авто, представлених в Україні, — зателефонуйте, і ми підкажемо, чи зможемо допомогти. Усі послуги — на сторінці <a href={IGN}>«Ключі запалювання»</a>.</p>
  </div></section>
</Base>
