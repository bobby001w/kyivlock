---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Blocks from '../../../components/Blocks.astro';
import W from '../../../components/Widgets.astro';
import LeadForm from '../../../components/LeadForm.astro';
import Icon from '../../../components/Icon.astro';
import Thumb from '../../../components/Thumb.astro';
import { IGN } from '../../../data/services';
import { IGN_HUB, IGN_PAGES, IGN_FAQ, SITUATIONS, HOWTO_STEPS } from '../../../data/ignition';
import { BRANDS } from '../../../data/brands';
import { DISTRICTS } from '../../../data/kyiv';
import { price, fmt } from '../../../data/prices';
import { service, faqPage, howTo } from '../../../lib/schema';
import { comboUrl, ignitionCombos, IGN_COMBO, brandUrl } from '../../../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((p) => p.data.cluster === 'ignition');
const kyivCombos = ignitionCombos.filter((p) => p.kind === 'district');
const oblCombos = ignitionCombos.filter((p) => p.kind !== 'district');
const schema = [
  service({ name: IGN_HUB.name, type: 'Ремонт замка запалювання', path: IGN, description: IGN_HUB.lead, priceIds: ['ign-diag', 'ign-repair', 'ign-cyl', 'ign-lock', 'ign-contact', 'ign-broken', 'ign-key-mech', 'ign-key-chip', 'ign-key-smart', 'ign-all-lost'] }),
  faqPage(IGN_FAQ),
  howTo('Що робити, якщо ключ запалювання не повертається', HOWTO_STEPS),
];
---
<Base title={IGN_HUB.title} description={IGN_HUB.description} path={IGN} crumbs={[{ name: 'Послуги', href: '/poslugy/' }, { name: 'Ключі запалювання', href: IGN }]} schema={schema} ogImage="/images/remont-zamka-zapaliuvannia-kyiv-1200.webp">
  <Hero h1={IGN_HUB.h1} lead={IGN_HUB.lead} variant="ignition" badges={['Виїзд у двір або на парковку', 'Майстерня для складних випадків', 'Перевірка документів', 'Гарантія на роботи']} />

  <section class="section"><div class="wrap">
    <h2>Усі послуги з ключами та замками запалювання</h2>
    <div class="grid g3">
      {IGN_PAGES.map((s) => <a class="card has-img" href={s.path}><Thumb file={s.image.file} alt={s.image.alt} /><h3>{s.name}</h3><p>{s.lead.split('. ')[0].replace(/[.!?…]?$/, (m) => m || '.')}</p></a>)}
      <a class="card has-img" href={IGN + 'marky/'}><Thumb file="vyhotovlennia-kliucha-zapaliuvannia" alt="Ключ із пультом у руці на тлі автомобіля" /><h3>Ключі та замки за марками авто</h3><p>Типові проблеми, ключі й ціни для Toyota, VW, Ford, BMW та інших марок.</p></a>
    </div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Ваша ситуація → що робимо → час → ціна</h2>
    <div class="tbl"><table>
      <thead><tr><th scope="col">Ваша ситуація</th><th scope="col">Що робимо</th><th scope="col">Орієнтовний час</th><th scope="col">Ціна від</th></tr></thead>
      <tbody>{SITUATIONS.map((s) => (
        <tr><td>{s.href ? <a href={IGN + s.href}>{s.s}</a> : s.s}</td><td>{s.d}</td><td>{s.t}</td><td class="p">{fmt(price(s.p))}</td></tr>
      ))}</tbody>
    </table></div>
    <p class="muted">Час і ціна орієнтовні: для частини авто потрібна діагностика та програмування. Точну вартість називаємо до початку робіт.</p>
  </div></section>

  <Blocks type="workshop" />
  <Blocks type="steps-ign" />

  <section class="section"><div class="wrap prose">
    <h2>Ремонт замка керма: кермо заблоковане і не розблоковується</h2>
    <p>Механічний протиугінний фіксатор керма вбудований у замок запалювання більшості авто. Якщо кермо заблоковане, а ключ не повертається, спершу спробуйте легенько повернути кермо в бік вільного ходу, одночасно повертаючи ключ. Якщо не допомогло — зношений фіксатор або личинка. На сучасних авто (Mercedes-Benz Sprinter і C-Class, VW Passat B6/B7, Audi A6, Nissan Qashqai) кермо блокує <strong>електронний модуль ELV/ESCL</strong>, і його відмова — окрема поломка: авто «не бачить» ключ, на панелі горить повідомлення про блокування керма. Ми ремонтуємо механічні фіксатори, а також ремонтуємо чи замінюємо електронні модулі з адаптацією до авто. Детальніше — на сторінці <a href={IGN + 'zamok-kerma/'}>«Розблокування та ремонт замка керма»</a>.</p>
    <h2>Після спроби викрадення або злому</h2>
    <p>Злодії часто намагаються провернути личинку викруткою або висвердлити її. Після такого замок запалювання зазвичай не працює, кожух кермової колонки зламаний, а проводка контактної групи пошкоджена. Ми <a href={IGN + 'zamina-zamka-zapaliuvannia/'}>замінимо замок запалювання</a> чи личинку, відновимо проводку, за потреби змінимо личинки дверей під один новий ключ і перевіримо імобілайзер. Видаємо акт для страхової компанії та поліції.</p>
    <h2>Мото- та спецтехніка</h2>
    <p>Окрім легкових авто, працюємо з <a href={brandUrl('skutery-motocykly')}>скутерами та мотоциклами</a> (виготовлення ключів за кодом замка, ремонт замків запалювання, бензобака та кофрів), а також з <a href={brandUrl('vantazhivky-mikroavtobusy')}>вантажівками, мікроавтобусами</a> та спецтехнікою — Sprinter, Crafter, Transit, Master, Daily, а також тягачами DAF, MAN, Volvo і Scania. Для автопарків — договір і безготівковий розрахунок.</p>
    <h2>Що робити, якщо ключ не повертається: коротка інструкція</h2>
    <ol>{HOWTO_STEPS.map((s) => <li><strong>{s.name}.</strong> {s.text}</li>)}</ol>
    <p>Детальніше — на сторінці <a href={IGN + 'kliuch-ne-povertaietsia/'}>«Ключ не повертається в замку запалювання»</a>.</p>
  </div></section>

  <Blocks type="ign-wait" />
  <section class="section soft"><div class="wrap">
    <h2>Ціни на ключі запалювання та ремонт замка запалювання</h2>
    <W type="prices" groups={['ignition']} />
  </div></section>
  <Blocks type="ign-timing" />
  <Blocks type="ownership-car" seed="ign" />
  <Blocks type="guarantee" />

  <section class="section soft"><div class="wrap">
    <h2>Ключі та замки запалювання за марками авто</h2>
    <W type="links" links={BRANDS.map((b) => ({ href: brandUrl(b.slug), name: b.name }))} />
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Ремонт замка запалювання у вашому районі</h2>
    <W type="links" links={kyivCombos.map((p) => ({ href: comboUrl(p, IGN_COMBO), name: `Ключі запалювання ${p.loc}` }))} />
    <h3>Київська область</h3>
    <W type="links" links={oblCombos.map((p) => ({ href: comboUrl(p, IGN_COMBO), name: `Ремонт замка запалювання ${p.loc}` }))} />
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Відгуки клієнтів</h2>
    <W type="reviews" service={IGN} />
  </div></section>

  <section class="section"><div class="wrap two">
    <div><h2>Часті питання про ключі та замки запалювання</h2><W type="faq" items={IGN_FAQ} /></div>
    <div><LeadForm variant="ignition" uid="bottom" title="Ремонт замка або новий ключ" /></div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Корисні статті</h2>
    <ul class="cols">{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul>
    <h2 style="margin-top:24px">Пов'язані послуги</h2>
    <W type="links" links={[{ href: '/poslugy/vidkryttia-avto/', name: 'Відкриття автомобілів' }, { href: '/poslugy/zamina-lychynky/', name: 'Заміна серцевини замка' }]} />
  </div></section>
</Base>
