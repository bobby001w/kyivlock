---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Blocks from '../../components/Blocks.astro';
import W from '../../components/Widgets.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SUBURBS, GROUPS, RAIONS, CITIES } from '../../data/oblast';
import { placeUrl, place, children } from '../../lib/site';
import { price, fmt } from '../../data/prices';
import { faqPage } from '../../lib/schema';
const faq = [
  { q: 'Скільки коштує виклик майстра в передмістя та область?', a: `Виклик майстра по Київській області — ${fmt(price('call-oblast'))}, по Києву — ${fmt(price('call-kyiv'))}. Вартість робіт називаємо до їх початку.` },
  { q: 'Чи приїжджаєте вночі в область?', a: 'Так, працюємо цілодобово. Для віддалених міст чесно називаємо реальний час приїзду — від 60 до 120 хвилин.' },
  { q: 'Що робити, якщо ви далеко, а допомога потрібна терміново?', a: 'Якщо дитина чи людина в небезпеці — телефонуйте 101/112. Ми чесно скажемо, чи встигнемо, і порадимо найшвидший варіант.' },
];
---
<Base title="Відкриття замків у Київській області — 24/7 | KyivLock" description="Відкриття дверей, авто, сейфів, ремонт замків запалювання в передмістях Києва та Київській області: Бровари, Ірпінь, Буча, Бориспіль. Дзвоніть {PHONE}." path="/kyivska-oblast/" crumbs={[{ name: 'Київська область', href: '/kyivska-oblast/' }]} schema={[faqPage(faq)]}>
  <Hero h1="Відкриття замків у передмістях Києва та Київській області" lead="Виїжджаємо в найближчі передмістя за 20–45 хвилин, а в міста області — за реалістичний час, який чесно називаємо під час дзвінка. Без обіцянок «10 хвилин до Білої Церкви»." badges={['Цілодобово', 'Передмістя від 20 хв', 'Чесний час приїзду', 'Прозора ціна виїзду']} />
  <section class="section"><div class="wrap">
    <h2>Передмістя Києва</h2>
    <W type="links" links={SUBURBS.map((s) => ({ href: placeUrl(s), name: `${s.name} — ${s.eta}` }))} />
    <h3>Малі села (групові сторінки)</h3>
    <W type="links" links={GROUPS.map((g) => ({ href: placeUrl(g), name: g.name }))} />
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Райони Київської області</h2>
    <div class="grid g2">
      {RAIONS.map((r) => (
        <div class="card"><h3><a href={placeUrl(r)}>{r.name}</a></h3>
          <p class="muted">{(r.micros ?? []).map((m) => m.name).join(', ')}</p>
          <W type="links" links={children(r).filter((c) => c.kind !== 'group').slice(0, 8).map((c) => ({ href: placeUrl(c), name: c.name }))} />
        </div>
      ))}
    </div>
  </div></section>
  <section class="section"><div class="wrap two">
    <div class="tbl"><table><caption>Час приїзду і виїзд у міста області</caption>
      <thead><tr><th scope="col">Місто</th><th scope="col">Час</th><th scope="col">Відстань</th></tr></thead>
      <tbody>{CITIES.map((c) => <tr><td><a href={placeUrl(c)}>{c.name}</a></td><td>{c.eta}</td><td>{c.distance}</td></tr>)}</tbody>
    </table></div>
    <div><W type="prices" ids={['call-kyiv', 'call-oblast', 'night']} /></div>
  </div></section>
  <Blocks type="ownership" seed="oblast" />
  <section class="section soft"><div class="wrap two">
    <div><h2>Питання і відповіді</h2><W type="faq" items={faq} /></div>
    <div><LeadForm uid="bottom" /></div>
  </div></section>
</Base>
