---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Blocks from '../components/Blocks.astro';
import W from '../components/Widgets.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import Thumb from '../components/Thumb.astro';
import { SERVICES, IGN } from '../data/services';
import { IGN_HUB } from '../data/ignition';
import { DISTRICTS } from '../data/kyiv';
import { BUSINESS, links } from '../data/business';
import { localBusiness, faqPage, abs } from '../lib/schema';
import { placeUrl, TOP_CITIES } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.updated.localeCompare(a.data.updated)).slice(0, 3);
const faq = [
  { q: 'Скільки коштує аварійне відкриття замка в Києві?', a: 'Відкриття дверей з простим циліндром — від 500 грн, броньованих дверей — від 1200 грн, авто — від 600 грн, сейфа — від 1000 грн, ремонт замка запалювання — від 2000 грн. Виклик майстра по Києву — 1000 грн, по області — 1500 грн. Фіксовану ціну називаємо до початку роботи.' },
  { q: 'Як швидко приїде майстер?', a: 'По Києву — зазвичай за 15–40 хвилин. Майстри чергують на обох берегах Дніпра.' },
  { q: 'Чи відкриваєте двері без пошкоджень?', a: 'Так, у понад 90% випадків — неруйнівним методом. Висвердлювання — лише за вашою згодою.' },
  { q: 'Як ви перевіряєте, що я власник?', a: 'Перевіряємо паспорт з реєстрацією, договір оренди чи купівлі, для авто — техпаспорт. Якщо документи всередині — перевіряємо одразу після відкриття.' },
  { q: 'Чи працюєте вночі та у свята?', a: 'Так, цілодобово, 7 днів на тиждень, включно зі святами.' },
  { q: 'Чи ремонтуєте замки запалювання?', a: 'Так: ремонт і заміна личинки, витяг зламаного ключа, ключі з чіпом, смарт-ключі, втрачені всі ключі.' },
];
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'KyivLock', url: abs('/'), inLanguage: 'uk' };
// Перше речення опису; якщо задовге — обрізаємо по слову, а не посеред слова.
const teaser = (lead: string) => { const f = lead.split('. ')[0]; return f.length <= 130 ? f : f.slice(0, f.lastIndexOf(' ', 127)).replace(/[,;:—–-]\s*$/, '') + '…'; };
const tiles = [...SERVICES.slice(0, 2), { path: IGN, name: IGN_HUB.name, image: { file: 'remont-zamka-zapaliuvannia-kyiv', alt: 'Кермо і ключ у замку запалювання автомобіля' }, lead: 'Ремонт і заміна замка запалювання, ключі з чіпом і смарт-ключі' }, ...SERVICES.slice(2)];
---
<Base title="Аварійне відкриття замків Київ — виїзд 15–20 хв | KyivLock" description="Аварійне відкриття дверей, авто, сейфів у Києві та області без пошкоджень. Цілодобово, від 500 грн, гарантія. Ремонт замків запалювання. Дзвоніть {PHONE}." path="/" schema={[localBusiness(), website, faqPage(faq)]}>
  <Hero h1="Аварійне відкриття замків у Києві та області" lead="Відкриємо двері, авто чи сейф без пошкоджень, замінимо замок або відремонтуємо замок запалювання. <strong>Цілодобово, виїзд від 15 хвилин</strong>, фіксована ціна до початку робіт." />

  <section class="section"><div class="wrap">
    <h2>Наші послуги</h2>
    <div class="grid g4">
      {tiles.map((s) => <a class="card has-img" href={s.path}><Thumb file={s.image.file} alt={s.image.alt} /><h3>{s.name}</h3><p>{teaser(s.lead)}</p></a>)}
    </div>
  </div></section>

  <Blocks type="steps" seed="home" />
  <Blocks type="advantages" />

  <section class="section soft"><div class="wrap two">
    <div>
      <h2>Ціни на відкриття замків</h2>
      <W type="prices" ids={['door-simple', 'door-armored', 'car-open', 'safe-open', 'cyl-replace', 'ign-repair', 'ign-cyl', 'ign-key-chip', 'ign-key-smart']} />
      <p><a href="/tsiny/">Повний прайс</a></p>
    </div>
    <div><W type="eta" /><div style="margin-top:16px"><LeadForm uid="prices" title="Дізнатися точну ціну" /></div></div>
  </div></section>

  <section class="section"><div class="wrap prose">
    <h2>Аварійне відкриття замків у Києві: коли кожна хвилина важлива</h2>
    <p>Захлопнулися двері, зламався ключ у замку, загубили ключі по дорозі додому або дитина зачинилася в квартирі — ці ситуації трапляються несподівано й завжди не вчасно. KyivLock — служба аварійного відкриття замків, яка працює цілодобово в усіх районах Києва та передмістях. Наші майстри чергують на правому й лівому березі, тому до більшості адрес приїжджають за 15–30 хвилин, а не годину.</p>
    <p>Ми відкриваємо вхідні, броньовані, тамбурні й міжкімнатні двері, сейфи, офіси та магазини, а також автомобілі будь-яких марок. Понад 90% замків відкриваємо <strong>неруйнівним методом</strong> — професійним інструментом для циліндрових і сувальдних механізмів. Працюємо з замками Mul-T-Lock, Cisa, Abloy, Gerda, Securemme, Kale, Mottura, а також з електронними та смарт-замками.</p>
    <h3>Чесна ціна і перевірка документів</h3>
    <p>Ми називаємо фіксовану вартість до початку робіт і не «накручуємо» ціну на місці. Відкриваємо двері лише власникам і мешканцям — перевіряємо паспорт з реєстрацією, договір оренди чи купівлі, для авто — техпаспорт. Так ми захищаємо вас від шахраїв і несумлінних «слюсарів», про яких ми розповідаємо в статті <a href="/blog/yak-ne-potrapyty-na-shakhraiv-sliusariv/">«Як не потрапити на шахраїв-слюсарів»</a>.</p>
    <h3>Ключі запалювання та ремонт замка запалювання</h3>
    <p>Окремий напрям — <a href={IGN}>ремонт і заміна замків запалювання</a>, виготовлення ключів з чіпом і смарт-ключів, відновлення доступу, коли втрачені всі ключі від авто. Ключ не повертається, застряг чи зламався — приїдемо до авто у двір, на парковку ТРЦ чи трасу.</p>
    <h3>Після відкриття</h3>
    <p>Якщо ключі загублені або замок зношений — одразу <a href="/poslugy/zamina-lychynky/">замінимо серцевину</a> чи <a href="/poslugy/zamina-zamkiv/">замок</a> з гарантією 12 місяців. У машині майстра завжди є запас популярних личинок і замків.</p>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Райони Києва та міста області</h2>
    <W type="links" links={DISTRICTS.map((d) => ({ href: placeUrl(d), name: d.name }))} />
    <h3>Передмістя та Київська область</h3>
    <W type="links" links={[...TOP_CITIES.map((c) => ({ href: placeUrl(c), name: c.name })), { href: '/kyivska-oblast/', name: 'Уся область →' }]} />
  </div></section>

  <Blocks type="ownership" seed="home" />

  <section class="section soft"><div class="wrap">
    <h2>Відгуки клієнтів</h2>
    <W type="reviews" />
    <p><a href="/vidhuky/">Усі відгуки</a></p>
  </div></section>

  <section class="section"><div class="wrap two">
    <div><h2>Часті питання</h2><W type="faq" items={faq} /><p><a href="/faq/">Усі питання і відповіді</a></p></div>
    <div><LeadForm uid="bottom" /></div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Корисні поради від майстрів</h2>
    <div class="grid g3">{posts.map((p) => <a class="card has-img" href={`/blog/${p.id}/`}>{p.data.image && <Thumb file={p.data.image} alt={p.data.imageAlt ?? p.data.title} />}<h3>{p.data.title}</h3><p class="muted">{p.data.description}</p></a>)}</div>
    <p><a href="/blog/">Усі статті блогу</a></p>
  </div></section>

  <section class="section"><div class="wrap two">
    <div>
      <h2>Контакти</h2>
      <p><strong>{BUSINESS.brand}</strong><br />{BUSINESS.address && <>{BUSINESS.address}<br /></>}
        Телефон: <a href={links.phone} data-ga="phone_click">{BUSINESS.phone}</a><br />
        E-mail: <a href={links.email}>{BUSINESS.email}</a><br />{BUSINESS.workingHours}</p>
      <p><a href="/kontakty/">Як нас знайти</a></p>
    </div>
    <iframe class="map" src={links.map} title="KyivLock на мапі Києва" loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="600" height="360"></iframe>
  </div></section>
</Base>
