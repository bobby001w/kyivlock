---
// Русская 404. Astro собирает её в /ru/404/index.html, scripts/postbuild.mjs переносит в /ru/404.html —
// Cloudflare Pages отдаёт ближайший 404.html, поэтому для адресов /ru/... покажется эта страница.
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import W from '../../components/Widgets.astro';
import { SERVICES, IGN } from '../../data/services';
import { DISTRICTS } from '../../data/kyiv';
import { placeUrl } from '../../lib/site';
---
<Base title="Страница не найдена (404) | KyivLock" description="Страница не найдена. Перейдите к услугам, районам или позвоните — мы на связи круглосуточно." path="/404/" noindex>
  <section class="section"><div class="wrap prose">
    <h1>Страница не найдена</h1>
    <p class="lead">Возможно, страницу перенесли или в адресе ошибка. Если вам срочно нужен мастер — позвоните, мы на связи 24/7.</p>
    <Cta />
    <h2>Услуги</h2>
    <W type="links" links={[...SERVICES.map((s) => ({ href: s.path, name: s.short })), { href: IGN, name: 'Ключи зажигания' }]} />
    <h2>Районы Киева</h2>
    <W type="links" links={DISTRICTS.map((d) => ({ href: placeUrl(d), name: d.name }))} />
    <p><a href="/">Главная</a> · <a href="/tsiny/">Цены</a> · <a href="/kontakty/">Контакты</a></p>
  </div></section>
</Base>
