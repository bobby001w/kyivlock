---
// Русская версия страницы марки: getStaticPaths отдаёт только слаг, данные берутся при рендере уже на русском.
import Base from '../../../../../layouts/Base.astro';
import Hero from '../../../../../components/Hero.astro';
import Blocks from '../../../../../components/Blocks.astro';
import W from '../../../../../components/Widgets.astro';
import LeadForm from '../../../../../components/LeadForm.astro';
import { IGN } from '../../../../../data/services';
import { BRANDS } from '../../../../../data/brands';
import { IGN_PAGES } from '../../../../../data/ignition';
import { service, faqPage } from '../../../../../lib/schema';
import { brandUrl, pickTitle, pickDesc } from '../../../../../lib/brand-seo';
export const getStaticPaths = () => BRANDS.map((b) => ({ params: { brand: b.slug } }));
const b = BRANDS.find((x) => x.slug === Astro.params.brand)!;
const path = brandUrl(b.slug);
const idx = BRANDS.findIndex((x) => x.slug === b.slug);
const others = [1, 2, 3, 4, 5].map((k) => BRANDS[(idx + k) % BRANDS.length]);
const title = pickTitle([
  `Ключи и замок зажигания ${b.name} — Киев | KyivLock`,
  `Ключ зажигания ${b.name} Киев — ремонт замка | KyivLock`,
  `Замок зажигания ${b.name}: ремонт и ключи | KyivLock`,
  `Ключи зажигания ${b.name} | KyivLock`,
]);
const description = pickDesc([
  `Ремонт замка зажигания и ключи для ${b.loc} в Киеве: ${b.keys.split(',')[0]}; ${b.models.split(', ').slice(0, 3).join(', ')}. Цены, сроки. Тел. {PHONE}.`,
  `Ремонт замка зажигания и ключи для ${b.loc} в Киеве: ${b.keys.split(',')[0]}. Типичные проблемы, сроки, цены. Тел. {PHONE}.`,
  `Ключи для ${b.loc}: ремонт замка зажигания, ключи с чипом, смарт-ключи. Киев и область. Тел. {PHONE}.`,
  `Ключи для ${b.loc} в Киеве. Тел. {PHONE}.`,
]);
const schema = [service({ name: `Ключи и замок зажигания ${b.name}`, type: 'Ремонт замка зажигания', path, description: b.intro, priceIds: ['ign-repair', 'ign-cyl', 'ign-key-chip', 'ign-key-smart', 'ign-all-lost'] }), faqPage(b.faq)];
---
<Base title={title} description={description} path={path} schema={schema} crumbs={[{ name: 'Услуги', href: '/poslugy/' }, { name: 'Ключи зажигания', href: IGN }, { name: 'Марки авто', href: IGN + 'marky/' }, { name: b.name, href: path }]}>
  <Hero h1={`Ключи и замок зажигания ${b.name} в Киеве`} lead={b.intro} variant="ignition" />
  <section class="section"><div class="wrap prose">
    <h2>Модели, с которыми работаем чаще всего</h2>
    <p>{b.models}.</p>
    <h2>Типы ключей {b.loc}</h2>
    <p>Для {b.loc} встречаются: {b.keys}. От типа ключа зависят способ изготовления, программирование и стоимость — поэтому во время звонка мы уточняем модель, год и при необходимости VIN.</p>
    <h2>Типичные проблемы замка зажигания и ключей {b.loc}</h2>
    <ul>{b.problems.map((x) => <li>{x}</li>)}</ul>
    <h2>Как мы решаем</h2>
    <p>{b.details}</p>
    <h2>Ориентировочные сроки</h2>
    <p>{b.timing} Точное время зависит от состояния замка, типа ключа и того, есть ли у вас рабочий ключ.</p>
    <h2>Услуги для {b.loc}</h2>
    <ul class="cols">{IGN_PAGES.map((s) => <li><a href={s.path}>{s.name}</a></li>)}</ul>
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Ориентировочные цены для {b.loc}</h2>
    <W type="prices" ids={['ign-diag', 'ign-repair', 'ign-cyl', 'ign-broken', 'ign-key-mech', 'ign-key-chip', 'ign-key-flip', 'ign-key-smart', 'ign-all-lost']} />
  </div></section>
  <Blocks type="ownership-car" seed={b.slug} />
  <section class="section"><div class="wrap two">
    <div><h2>Вопросы о ключах {b.loc}</h2><W type="faq" items={b.faq} /></div>
    <div><LeadForm variant="ignition" uid="bottom" title={`${b.name}: ремонт замка и ключи`} /></div>
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Другие марки</h2>
    <W type="links" links={[...others.map((o) => ({ href: brandUrl(o.slug), name: `Ключи зажигания ${o.name}` })), { href: IGN + 'marky/', name: 'Все марки' }]} />
  </div></section>
</Base>
