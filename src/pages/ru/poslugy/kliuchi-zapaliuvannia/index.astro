---
import Base from '../../../../layouts/Base.astro';
import Hero from '../../../../components/Hero.astro';
import Blocks from '../../../../components/Blocks.astro';
import W from '../../../../components/Widgets.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import Icon from '../../../../components/Icon.astro';
import Thumb from '../../../../components/Thumb.astro';
import { IGN } from '../../../../data/services';
import { IGN_HUB, IGN_PAGES, IGN_FAQ, SITUATIONS, HOWTO_STEPS } from '../../../../data/ignition';
import { BRANDS } from '../../../../data/brands';
import { price, fmt } from '../../../../data/prices';
import { service, faqPage, howTo } from '../../../../lib/schema';
import { comboUrl, ignitionCombos, IGN_COMBO, brandUrl } from '../../../../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogRu')).filter((p) => p.data.cluster === 'ignition');
const kyivCombos = ignitionCombos.filter((p) => p.kind === 'district');
const oblCombos = ignitionCombos.filter((p) => p.kind !== 'district');
const schema = [
  service({ name: IGN_HUB.name, type: 'Ремонт замка зажигания', path: IGN, description: IGN_HUB.lead, priceIds: ['ign-diag', 'ign-repair', 'ign-cyl', 'ign-lock', 'ign-contact', 'ign-broken', 'ign-key-mech', 'ign-key-chip', 'ign-key-smart', 'ign-all-lost'] }),
  faqPage(IGN_FAQ),
  howTo('Что делать, если ключ зажигания не поворачивается', HOWTO_STEPS),
];
---
<Base title={IGN_HUB.title} description={IGN_HUB.description} path={IGN} crumbs={[{ name: 'Услуги', href: '/poslugy/' }, { name: 'Ключи зажигания', href: IGN }]} schema={schema} ogImage="/images/remont-zamka-zapaliuvannia-kyiv-1200.webp">
  <Hero h1={IGN_HUB.h1} lead={IGN_HUB.lead} variant="ignition" badges={['Выезд во двор или на парковку', 'Мастерская для сложных случаев', 'Проверка документов', 'Гарантия 6 месяцев']} />

  <section class="section"><div class="wrap">
    <h2>Все услуги с ключами и замками зажигания</h2>
    <div class="grid g3">
      {IGN_PAGES.map((s) => <a class="card has-img" href={s.path}><Thumb file={s.image.file} alt={s.image.alt} /><h3>{s.name}</h3><p>{s.lead.split('. ')[0].replace(/[.!?…]?$/, (m) => m || '.')}</p></a>)}
      <a class="card has-img" href={IGN + 'marky/'}><Thumb file="vyhotovlennia-kliucha-zapaliuvannia" alt="Ключ с пультом в руке на фоне автомобиля" /><h3>Ключи и замки по маркам авто</h3><p>Типичные проблемы, ключи и цены для Toyota, VW, Ford, BMW и других марок.</p></a>
    </div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Ваша ситуация → что делаем → время → цена</h2>
    <div class="tbl"><table>
      <thead><tr><th scope="col">Ваша ситуация</th><th scope="col">Что делаем</th><th scope="col">Ориентировочное время</th><th scope="col">Цена от</th></tr></thead>
      <tbody>{SITUATIONS.map((s) => (
        <tr><td>{s.href ? <a href={IGN + s.href}>{s.s}</a> : s.s}</td><td>{s.d}</td><td>{s.t}</td><td class="p">{fmt(price(s.p))}</td></tr>
      ))}</tbody>
    </table></div>
    <p class="muted">Время и цена ориентировочные: для части авто нужны диагностика и программирование. Точную стоимость называем до начала работ.</p>
  </div></section>

  <Blocks type="workshop" />
  <Blocks type="steps-ign" />

  <section class="section"><div class="wrap prose">
    <h2>Ремонт замка руля: руль заблокирован и не разблокируется</h2>
    <p>Механический противоугонный фиксатор руля встроен в замок зажигания большинства авто. Если руль заблокирован, а ключ не поворачивается, сначала попробуйте слегка повернуть руль в сторону свободного хода, одновременно поворачивая ключ. Если не помогло — изношен фиксатор или личинка. На современных авто (Mercedes-Benz Sprinter и C-Class, VW Passat B6/B7, Audi A6, Nissan Qashqai) руль блокирует <strong>электронный модуль ELV/ESCL</strong>, и его отказ — отдельная поломка: авто «не видит» ключ, на панели горит сообщение о блокировке руля. Мы ремонтируем механические фиксаторы, а также ремонтируем или заменяем электронные модули с адаптацией к авто. Подробнее — на странице <a href={IGN + 'zamok-kerma/'}>«Разблокировка и ремонт замка руля»</a>.</p>
    <h2>После попытки угона или взлома</h2>
    <p>Угонщики часто пытаются провернуть личинку отвёрткой или высверлить её. После этого замок зажигания обычно не работает, кожух рулевой колонки сломан, а проводка контактной группы повреждена. Мы <a href={IGN + 'zamina-zamka-zapaliuvannia/'}>заменим замок зажигания</a> или личинку, восстановим проводку, при необходимости сменим личинки дверей под один новый ключ и проверим иммобилайзер. Выдаём акт для страховой компании и полиции.</p>
    <h2>Мото- и спецтехника</h2>
    <p>Кроме легковых авто, работаем со <a href={brandUrl('skutery-motocykly')}>скутерами и мотоциклами</a> (изготовление ключей по коду замка, ремонт замков зажигания, бензобака и кофров), а также с <a href={brandUrl('vantazhivky-mikroavtobusy')}>грузовиками, микроавтобусами</a> и спецтехникой — Sprinter, Crafter, Transit, Master, Daily, а также тягачами DAF, MAN, Volvo и Scania. Для автопарков — договор и безналичный расчёт.</p>
    <h2>Что делать, если ключ не поворачивается: краткая инструкция</h2>
    <ol>{HOWTO_STEPS.map((s) => <li><strong>{s.name}.</strong> {s.text}</li>)}</ol>
    <p>Подробнее — на странице <a href={IGN + 'kliuch-ne-povertaietsia/'}>«Ключ не поворачивается в замке зажигания»</a>.</p>
  </div></section>

  <Blocks type="ign-wait" />
  <section class="section soft"><div class="wrap">
    <h2>Цены на ключи зажигания и ремонт замка зажигания</h2>
    <W type="prices" groups={['ignition']} />
  </div></section>
  <Blocks type="ign-timing" />
  <Blocks type="ownership-car" seed="ign" />
  <Blocks type="guarantee" />

  <section class="section soft"><div class="wrap">
    <h2>Ключи и замки зажигания по маркам авто</h2>
    <W type="links" links={BRANDS.map((b) => ({ href: brandUrl(b.slug), name: b.name }))} />
  </div></section>

  <section class="section"><div class="wrap">
    <h2>Ремонт замка зажигания в вашем районе</h2>
    <W type="links" links={kyivCombos.map((p) => ({ href: comboUrl(p, IGN_COMBO), name: `Ключи зажигания ${p.loc}` }))} />
    <h3>Киевская область</h3>
    <W type="links" links={oblCombos.map((p) => ({ href: comboUrl(p, IGN_COMBO), name: `Ремонт замка зажигания ${p.loc}` }))} />
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Отзывы клиентов</h2>
    <W type="reviews" service={IGN} />
  </div></section>

  <section class="section"><div class="wrap two">
    <div><h2>Частые вопросы о ключах и замках зажигания</h2><W type="faq" items={IGN_FAQ} /></div>
    <div><LeadForm variant="ignition" uid="bottom" title="Ремонт замка или новый ключ" /></div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <h2>Полезные статьи</h2>
    <ul class="cols">{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul>
    <h2 style="margin-top:24px">Связанные услуги</h2>
    <W type="links" links={[{ href: '/poslugy/vidkryttia-avto/', name: 'Вскрытие автомобилей' }, { href: '/poslugy/vyhotovlennia-kliuchiv/', name: 'Изготовление ключей' }, { href: '/poslugy/zamina-lychynky/', name: 'Замена сердцевины замка' }]} />
  </div></section>
</Base>
