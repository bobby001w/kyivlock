---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import W from '../../components/Widgets.astro';
import { BUSINESS, links, filled } from '../../data/business';
import { DISTRICTS } from '../../data/kyiv';
import { localBusiness } from '../../lib/schema';
import { placeUrl } from '../../lib/site';
---
<Base title="Контакты KyivLock — телефон, адрес, карта | Киев 24/7" description="Телефон, мессенджеры, e-mail и адрес KyivLock. Работаем круглосуточно в Киеве и Киевской области. Карта проезда, отзывы в Google. Звоните {PHONE}." path="/kontakty/" crumbs={[{ name: 'Контакты', href: '/kontakty/' }]} schema={[localBusiness()]}>
  <Hero h1="Контакты KyivLock" lead="Мы на связи круглосуточно. Быстрее всего — позвонить: диспетчер сразу назовёт цену и время приезда." />
  <section class="section"><div class="wrap two">
    <div>
      <h2>Как с нами связаться</h2>
      <ul>
        <li>Телефон: <a href={links.phone} data-ga="phone_click"><strong>{BUSINESS.phone}</strong></a></li>
        {BUSINESS.telegram && <li>Telegram: <a href={links.telegram} data-ga="messenger_click" data-ch="telegram" rel="noopener">@{BUSINESS.telegram}</a></li>}
        {BUSINESS.viber && <li>Viber: <a href={links.viber} data-ga="messenger_click" data-ch="viber">{BUSINESS.viber}</a></li>}
        {BUSINESS.whatsapp && <li>WhatsApp: <a href={links.whatsapp} data-ga="messenger_click" data-ch="whatsapp" rel="noopener">{BUSINESS.whatsapp}</a></li>}
        <li>E-mail: <a href={links.email}>{BUSINESS.email}</a></li>
        {BUSINESS.address && <li>Адрес офиса / базы: {BUSINESS.address}</li>}
        {BUSINESS.workshopAddress && <li>Мастерская (ключи зажигания): {BUSINESS.workshopAddress}</li>}
        <li>График: круглосуточно, 24/7</li>
      </ul>
      {filled(BUSINESS.legalName) && <><h2>Реквизиты</h2>
      <p>{BUSINESS.legalName}{BUSINESS.edrpou && <><br />Код ЕГРПОУ / РНУКПН: {BUSINESS.edrpou}</>}</p></>}
      {BUSINESS.googleBusinessUrl && <><h2>Google Business Profile</h2>
      <div class="ctas"><a class="btn btn-line" href={BUSINESS.googleBusinessUrl} rel="noopener">Мы на Google Картах и отзывы</a>{BUSINESS.googleReviewUrl && <a class="btn btn-call" href={BUSINESS.googleReviewUrl} rel="noopener">Оставить отзыв</a>}</div></>}
    </div>
    <LeadForm uid="side" />
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Карта проезда</h2>
    <iframe class="map" src={links.map} title="Адрес KyivLock на карте" loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="1200" height="360"></iframe>
    <h2 style="margin-top:32px">Зона обслуживания</h2>
    <p>Все 10 районов Киева, пригороды и Киевская область. Время приезда по Киеву — 15–40 минут, в пригороды — 20–50 минут, в города области — по договорённости.</p>
    <W type="links" links={[...DISTRICTS.map((d) => ({ href: placeUrl(d), name: d.name })), { href: '/kyivska-oblast/', name: 'Киевская область' }]} />
  </div></section>
</Base>
