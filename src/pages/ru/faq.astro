---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import W from '../../components/Widgets.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SERVICES } from '../../data/services';
import { IGN_FAQ } from '../../data/ignition';
import { faqPage } from '../../lib/schema';
const general = [
  { q: 'Как быстро приедет мастер по Киеву?', a: 'Обычно за 15–40 минут в зависимости от района и трафика. Мастера дежурят на обоих берегах.' },
  { q: 'Работаете круглосуточно?', a: 'Да, 24/7, без выходных и праздников.' },
  { q: 'Как оплатить?', a: 'Переводом на карту или безналично на счёт ФЛП (в том числе для юридических лиц). Подробнее — на странице <a href="/oplata-i-vyizd/">«Оплата и выезд»</a>.' },
  { q: 'Даёте гарантию?', a: 'Да, даём гарантию на выполненные работы — и с замками дверей, и с замками зажигания и ключами. На детали — гарантия производителя.' },
  { q: 'Чем вы отличаетесь от «слесарей из объявлений»?', a: 'Фиксированной ценой до начала работ, проверкой документов и гарантией. Мы не меняем цену на месте.' },
];
const groups = [
  { title: 'Общие вопросы', items: general },
  ...SERVICES.slice(0, 5).map((s) => ({ title: s.name, items: s.faq.slice(0, 3) })),
  { title: 'Ключи и замки зажигания', items: IGN_FAQ },
];
---
<Base title="Вопросы и ответы о вскрытии замков — FAQ | KyivLock" description="Ответы на частые вопросы: сколько стоит открыть дверь, как быстро приедет мастер, какие нужны документы, гарантия, ключи зажигания. Тел. {PHONE}." path="/faq/" crumbs={[{ name: 'Вопросы и ответы', href: '/faq/' }]} schema={[faqPage(groups.flatMap((g) => g.items))]}>
  <Hero h1="Вопросы и ответы о вскрытии замков" lead="Собрали ответы на вопросы, которые нам задают чаще всего. Не нашли свой — позвоните, подскажем бесплатно." />
  <section class="section"><div class="wrap two">
    <div>{groups.map((g) => <><h2>{g.title}</h2><W type="faq" items={g.items} /></>)}</div>
    <div><LeadForm uid="side" /></div>
  </div></section>
</Base>
