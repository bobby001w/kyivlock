---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import Blocks from '../../../components/Blocks.astro';
import W from '../../../components/Widgets.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { SUBURBS, GROUPS, RAIONS, CITIES } from '../../../data/oblast';
import { placeUrl, children } from '../../../lib/site';
import { price, fmt } from '../../../data/prices';
import { faqPage } from '../../../lib/schema';
const faq = [
  { q: 'Сколько стоит вызов мастера в пригород и область?', a: `Вызов мастера по Киевской области — ${fmt(price('call-oblast'))}, по Киеву — ${fmt(price('call-kyiv'))}. Стоимость работ называем до их начала.` },
  { q: 'Приезжаете ночью в область?', a: 'Да, работаем круглосуточно. Для отдалённых городов честно называем реальное время приезда — от 60 до 120 минут.' },
  { q: 'Что делать, если вы далеко, а помощь нужна срочно?', a: 'Если ребёнок или человек в опасности — звоните 101/112. Мы честно скажем, успеем ли, и посоветуем самый быстрый вариант.' },
];
---
<Base title="Вскрытие замков в Киевской области — 24/7 | KyivLock" description="Вскрытие дверей, авто, сейфов, ремонт замков зажигания в пригородах Киева и Киевской области: Бровары, Ирпень, Буча, Борисполь. Звоните {PHONE}." path="/kyivska-oblast/" crumbs={[{ name: 'Киевская область', href: '/kyivska-oblast/' }]} schema={[faqPage(faq)]}>
  <Hero h1="Вскрытие замков в пригородах Киева и Киевской области" lead="Выезжаем в ближайшие пригороды за 20–45 минут, а в города области — за реалистичное время, которое честно называем во время звонка. Без обещаний «10 минут до Белой Церкви»." badges={['Круглосуточно', 'Пригород от 20 мин', 'Честное время приезда', 'Прозрачная цена выезда']} />
  <section class="section"><div class="wrap">
    <h2>Пригороды Киева</h2>
    <W type="links" links={SUBURBS.map((s) => ({ href: placeUrl(s), name: `${s.name} — ${s.eta}` }))} />
    <h3>Малые сёла (групповые страницы)</h3>
    <W type="links" links={GROUPS.map((g) => ({ href: placeUrl(g), name: g.name }))} />
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Районы Киевской области</h2>
    <div class="grid g2">
      {RAIONS.map((r) => (
        <div class="card"><h3><a href={placeUrl(r)}>{r.name}</a></h3>
          <p class="muted">{(r.micros ?? []).map((m) => m.name).join(', ')}</p>
          <W type="links" links={children(r).filter((c) => c.kind !== 'group').slice(0, 8).map((c) => ({ href: placeUrl(c), name: c.name }))} />
        </div>
      ))}
    </div>
  </div></section>
  <section class="section"><div class="wrap two">
    <div class="tbl"><table><caption>Время приезда и выезд в города области</caption>
      <thead><tr><th scope="col">Город</th><th scope="col">Время</th><th scope="col">Расстояние</th></tr></thead>
      <tbody>{CITIES.map((c) => <tr><td><a href={placeUrl(c)}>{c.name}</a></td><td>{c.eta}</td><td>{c.distance}</td></tr>)}</tbody>
    </table></div>
    <div><W type="prices" ids={['call-kyiv', 'call-oblast', 'night']} /></div>
  </div></section>
  <Blocks type="ownership" seed="oblast" />
  <section class="section soft"><div class="wrap two">
    <div><h2>Вопросы и ответы</h2><W type="faq" items={faq} /></div>
    <div><LeadForm uid="bottom" /></div>
  </div></section>
</Base>
