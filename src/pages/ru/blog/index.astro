---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Thumb from '../../../components/Thumb.astro';
const posts = (await getCollection('blogRu')).sort((a, b) => b.data.updated.localeCompare(a.data.updated));
const groups = [
  { id: 'general', title: 'Двери, замки и безопасность' },
  { id: 'doors', title: 'Что делать в аварийной ситуации' },
  { id: 'ignition', title: 'Ключи и замки зажигания' },
] as const;
---
<Base title="Блог KyivLock — советы мастеров о замках и ключах" description="Практические советы от мастеров KyivLock: что делать, если захлопнулась дверь, как выбрать замок, цены в Киеве, ключи зажигания, как не попасть на мошенников." path="/blog/" crumbs={[{ name: 'Блог', href: '/blog/' }]}>
  <section class="section"><div class="wrap">
    <h1>Полезное: советы мастеров KyivLock</h1>
    <p class="lead">Пишем из опыта ежедневных выездов: как действовать в аварийной ситуации, как выбрать замок и как не переплатить.</p>
    {groups.map((g) => {
      const list = posts.filter((p) => p.data.cluster === g.id);
      return list.length > 0 && (
        <>
          <h2>{g.title}</h2>
          <div class="grid g3" style="margin-bottom:32px">{list.map((p) => <a class="card has-img" href={`/blog/${p.id}/`}>{p.data.image && <Thumb file={p.data.image} alt={p.data.imageAlt ?? p.data.title} />}<h3>{p.data.title}</h3><p class="muted">{p.data.description}</p></a>)}</div>
        </>
      );
    })}
  </div></section>
</Base>
