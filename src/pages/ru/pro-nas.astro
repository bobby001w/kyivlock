---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Blocks from '../../components/Blocks.astro';
import W from '../../components/Widgets.astro';
import { BUSINESS, TEAM, OWNER, filled } from '../../data/business';
import { person } from '../../lib/schema';
// Блоки с пустыми данными (год основания, цифры, команда) не выводятся, пока их не заполнили в business.ts.
const team = TEAM.filter((t) => filled(t.name));
const stats = [
  ['Лет опыта', BUSINESS.yearsExperience],
  ['Выполненных выездов', BUSINESS.jobsDone],
  ['Среднее время приезда по Киеву', BUSINESS.avgArrival && `${BUSINESS.avgArrival} мин`],
].filter(([, v]) => v);
---
<Base title="О KyivLock — мастера аварийного вскрытия замков в Киеве" description="Кто мы: команда мастеров KyivLock, опыт, оборудование, регистрационные данные и принципы работы. Вскрываем замки только владельцам. Звоните {PHONE}." path="/pro-nas/" crumbs={[{ name: 'О нас', href: '/pro-nas/' }]} schema={team.map(person)}>
  <Hero h1="О KyivLock: мастера, которым доверяют доступ к дому" lead={`Мы — команда мастеров по аварийному вскрытию и ремонту замков, которая работает в Киеве и области${BUSINESS.foundedYear ? ` с ${BUSINESS.foundedYear} года` : ''}. Наш принцип простой: быстро, без повреждений, по честной цене и только для владельца.`} />
  <section class="section"><div class="wrap prose">
    {stats.length > 0 && <><h2>KyivLock в цифрах</h2>
    <ul>{stats.map(([k, v]) => <li>{k}: <strong>{v}</strong></li>)}</ul></>}
    {OWNER !== BUSINESS.brand && <><h2>Регистрационные данные</h2>
    <p>{OWNER}{BUSINESS.address && `. Адрес: ${BUSINESS.address}`}. Работаем официально как ФЛП, заключаем договоры с юридическими лицами.</p></>}
    <h2>Оборудование</h2>
    <p>Профессиональные наборы для неразрушающего вскрытия цилиндровых и сувальдных замков, декодеры Lishi, пневмоподушки для авто, электронный станок для ключей, программаторы транспондеров и смарт-ключей, экстракторы обломков ключей, диагностические сканеры OBD.</p>
    <h2>Наши принципы</h2>
    <ul>
      <li>Вскрываем только владельцам и жильцам — проверяем документы в каждом случае.</li>
      <li>Фиксированная цена до начала работ, без доплат на месте.</li>
      <li>Неразрушающее вскрытие — приоритет; высверливание только с согласия клиента.</li>
      <li>Не храним копии ключей и кодов клиентов.</li>
      <li>Честно говорим, если задачу лучше решить иначе (например, через официальный сервис авто).</li>
    </ul>
  </div></section>
  {team.length > 0 && <section class="section soft"><div class="wrap">
    <h2>Команда мастеров</h2>
    <div class="grid g3">{team.map((t) => (
      <div class="card"><W type="img" file={t.photo} alt={`${t.name} — ${t.role}, KyivLock`} sizes="(min-width: 960px) 360px, 100vw" />
        <h3>{t.name}</h3><p class="muted">{t.role}{filled(t.exp) && `. Опыт: ${t.exp} лет`}.</p><p>{t.about}</p></div>
    ))}</div>
  </div></section>}
  <Blocks type="ownership" seed="about" />
  <Blocks type="advantages" />
</Base>
