---
// Російська версія: getStaticPaths дає лише слаги, а об'єкт береться під час рендеру — вже в контексті /ru/ (дані російською).
import ComboPage from '../../../../components/ComboPage.astro';
import { doorCombos, place } from '../../../../lib/site';
export const getStaticPaths = () => doorCombos.map((p) => ({ params: { slug: p.slug } }));
const p = place(Astro.params.slug!)!;
---
<ComboPage p={p} kind="door" />
