---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import W from '../../components/Widgets.astro';
import LeadForm from '../../components/LeadForm.astro';
import { PRICE_GROUPS } from '../../data/prices';
import { faqPage } from '../../lib/schema';
const faq = [
  { q: 'Почему цена ориентировочная?', a: 'Стоимость зависит от типа и класса секретности замка, состояния механизма и сложности работы. Мастер называет фиксированную цену после осмотра, до начала работ, — и она не меняется.' },
  { q: 'Что входит в стоимость выезда?', a: 'Дорога мастера, осмотр замка и консультация. Вызов мастера по Киеву — 1000 грн, по Киевской области — 1500 грн.' },
  { q: 'Есть ли скрытые платежи?', a: 'Нет. Отдельно оплачиваются только комплектующие (личинка, замок, заготовка ключа), о чём мастер предупреждает заранее.' },
  { q: 'Есть ли ночной тариф?', a: 'Нет. Ночью, в выходные и праздники цена такая же, как днём.' },
];
---
<Base title="Цены на вскрытие замков в Киеве 2026 — прайс | KyivLock" description="Прайс: вскрытие дверей от 500 грн, авто от 600 грн, сейфов от 1000 грн, замена личинки, ключи зажигания. Цена — до начала работ. Тел. {PHONE}." path="/tsiny/" crumbs={[{ name: 'Цены', href: '/tsiny/' }]} schema={[faqPage(faq)]}>
  <Hero h1="Цены на вскрытие замков, замену и ключи зажигания" lead="Цены ориентировочные: точную стоимость мастер называет после осмотра, <strong>до начала работ</strong>. Без скрытых платежей и «накруток» на месте." />
  <section class="section"><div class="wrap two">
    <div><W type="prices" groups={PRICE_GROUPS.map((g) => g.id)} /></div>
    <div><LeadForm uid="side" title="Узнать точную цену" /></div>
  </div></section>
  <section class="section soft"><div class="wrap prose"><h2>Вопросы о ценах</h2><W type="faq" items={faq} /><p>Способы оплаты и условия выезда — на странице <a href="/oplata-i-vyizd/">«Оплата и выезд»</a>, гарантии — <a href="/harantiia/">«Гарантия»</a>.</p></div></section>
</Base>
