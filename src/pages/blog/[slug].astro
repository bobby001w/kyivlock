---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import W from '../../components/Widgets.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getCollection, render } from 'astro:content';
import { article } from '../../lib/schema';
import { SERVICES, IGN } from '../../data/services';
import { IGN_PAGES } from '../../data/ignition';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const allSvc = [...SERVICES, ...IGN_PAGES, { path: IGN, name: 'Ключі запалювання та ремонт замка запалювання' }];
const related = d.related.map((p) => allSvc.find((s) => s.path === p)).filter(Boolean) as { path: string; name: string }[];
const more = posts.filter((p) => p.id !== post.id && p.data.cluster === d.cluster).slice(0, 4);
const human = (s: string) => new Date(s).toLocaleDateString('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.seoTitle} description={d.description} path={path} ogType="article" ogImage={`/images/${d.image}-1200.webp`}
  crumbs={[{ name: 'Блог', href: '/blog/' }, { name: d.title, href: path }]}
  schema={[article({ title: d.title, description: d.description, path, date: d.date, updated: d.updated, author: d.author, image: `/images/${d.image}-1200.webp` })]}>
  <article class="section"><div class="wrap two" style="align-items:start">
    <div class="prose">
      <h1>{d.title}</h1>
      <p class="muted">Автор: <a href="/pro-nas/">{d.author}</a>, {d.authorRole}. Опубліковано <time datetime={d.date}>{human(d.date)}</time>, оновлено <time datetime={d.updated}>{human(d.updated)}</time>.</p>
      <W type="img" file={d.image} alt={d.imageAlt} eager sizes="(min-width: 960px) 600px, 100vw" />
      <Content />
      {d.sources.length > 0 && (<><h2>Джерела</h2><ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.name}</a></li>)}</ul></>)}
      <div class="note"><p><strong>Потрібна допомога зараз?</strong> Майстер KyivLock приїде цілодобово.</p><Cta compact /></div>
    </div>
    <aside>
      <LeadForm variant={d.cluster === 'ignition' ? 'ignition' : 'default'} uid="aside" />
      {related.length > 0 && <div class="card" style="margin-top:16px"><h2 class="h">Послуги за темою</h2><ul>{related.map((r) => <li><a href={r.path}>{r.name}</a></li>)}</ul></div>}
    </aside>
  </div></article>
  {more.length > 0 && <section class="section soft"><div class="wrap"><h2>Читайте також</h2><div class="grid g4">{more.map((p) => <a class="card" href={`/blog/${p.id}/`}><h3>{p.data.title}</h3></a>)}</div></div></section>}
</Base>
