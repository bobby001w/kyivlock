---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import W from '../components/Widgets.astro';
import { BUSINESS, links, filled } from '../data/business';
import { DISTRICTS } from '../data/kyiv';
import { localBusiness } from '../lib/schema';
import { placeUrl } from '../lib/site';
---
<Base title="Контакти KyivLock — телефон, адреса, мапа | Київ 24/7" description="Телефони, месенджери, e-mail та адреса KyivLock. Працюємо цілодобово в Києві та Київській області. Мапа проїзду, відгуки на Google. Дзвоніть {PHONE}." path="/kontakty/" crumbs={[{ name: 'Контакти', href: '/kontakty/' }]} schema={[localBusiness()]}>
  <Hero h1="Контакти KyivLock" lead="Ми на зв'язку цілодобово. Найшвидше — подзвонити: диспетчер одразу назве ціну та час приїзду." />
  <section class="section"><div class="wrap two">
    <div>
      <h2>Як з нами зв'язатися</h2>
      <ul>
        <li>Телефон: <a href={links.phone} data-ga="phone_click"><strong>{BUSINESS.phone}</strong></a></li>
        {BUSINESS.telegram && <li>Telegram: <a href={links.telegram} data-ga="messenger_click" data-ch="telegram" rel="noopener">@{BUSINESS.telegram}</a></li>}
        {BUSINESS.viber && <li>Viber: <a href={links.viber} data-ga="messenger_click" data-ch="viber">{BUSINESS.viber}</a></li>}
        {BUSINESS.whatsapp && <li>WhatsApp: <a href={links.whatsapp} data-ga="messenger_click" data-ch="whatsapp" rel="noopener">{BUSINESS.whatsapp}</a></li>}
        <li>E-mail: <a href={links.email}>{BUSINESS.email}</a></li>
        {BUSINESS.address && <li>Адреса офісу / бази: {BUSINESS.address}</li>}
        {BUSINESS.workshopAddress && <li>Майстерня (ключі запалювання): {BUSINESS.workshopAddress}</li>}
        <li>Графік: {BUSINESS.workingHours}</li>
      </ul>
      {filled(BUSINESS.legalName) && <><h2>Реквізити</h2>
      <p>{BUSINESS.legalName}{BUSINESS.edrpou && <><br />Код ЄДРПОУ / РНОКПП: {BUSINESS.edrpou}</>}</p></>}
      {BUSINESS.googleBusinessUrl && <><h2>Google Business Profile</h2>
      <div class="ctas"><a class="btn btn-line" href={BUSINESS.googleBusinessUrl} rel="noopener">Ми на Google Картах і відгуки</a>{BUSINESS.googleReviewUrl && <a class="btn btn-call" href={BUSINESS.googleReviewUrl} rel="noopener">Залишити відгук</a>}</div></>}
    </div>
    <LeadForm uid="side" />
  </div></section>
  <section class="section soft"><div class="wrap">
    <h2>Мапа проїзду</h2>
    <iframe class="map" src={links.map} title="Адреса KyivLock на мапі" loading="lazy" referrerpolicy="no-referrer-when-downgrade" width="1200" height="360"></iframe>
    <h2 style="margin-top:32px">Зона обслуговування</h2>
    <p>Усі 10 районів Києва, передмістя та Київська область. Час приїзду по Києву — 15–40 хвилин, у передмістя — 20–50 хвилин, у міста області — за домовленістю.</p>
    <W type="links" links={[...DISTRICTS.map((d) => ({ href: placeUrl(d), name: d.name })), { href: '/kyivska-oblast/', name: 'Київська область' }]} />
  </div></section>
</Base>
