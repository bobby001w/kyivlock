---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import W from '../components/Widgets.astro';
import LeadForm from '../components/LeadForm.astro';
import { PRICE_GROUPS } from '../data/prices';
import { faqPage } from '../lib/schema';
const faq = [
  { q: 'Чому ціна орієнтовна?', a: 'Вартість залежить від типу і класу секретності замка, стану механізму та часу виклику. Майстер називає фіксовану ціну після огляду, до початку робіт, — і вона не змінюється.' },
  { q: 'Що входить у вартість виїзду?', a: 'Дорога майстра, огляд замка і консультація. Виклик майстра по Києву — 1000 грн, по Київській області — 1500 грн.' },
  { q: 'Чи є приховані платежі?', a: 'Ні. Окремо оплачуються лише комплектуючі (личинка, замок, заготовка ключа), про що майстер попереджає заздалегідь.' },
];
---
<Base title="Ціни на відкриття замків у Києві 2026 — прайс | KyivLock" description="Прайс: відкриття дверей від 500 грн, авто від 600 грн, сейфів від 1000 грн, заміна личинки, ключі запалювання. Ціна — до робіт. Тел. {PHONE}." path="/tsiny/" crumbs={[{ name: 'Ціни', href: '/tsiny/' }]} schema={[faqPage(faq)]}>
  <Hero h1="Ціни на відкриття замків, заміну та ключі запалювання" lead="Ціни орієнтовні: точну вартість майстер називає після огляду, <strong>до початку робіт</strong>. Без прихованих платежів і «накруток» на місці." />
  <section class="section"><div class="wrap two">
    <div><W type="prices" groups={PRICE_GROUPS.map((g) => g.id)} /></div>
    <div><LeadForm uid="side" title="Дізнатися точну ціну" /></div>
  </div></section>
  <section class="section soft"><div class="wrap prose"><h2>Питання про ціни</h2><W type="faq" items={faq} /><p>Способи оплати та умови виїзду — на сторінці <a href="/oplata-i-vyizd/">«Оплата і виїзд»</a>, гарантії — <a href="/harantiia/">«Гарантія»</a>.</p></div></section>
</Base>
