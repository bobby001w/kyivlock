---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Blocks from '../components/Blocks.astro';
import W from '../components/Widgets.astro';
import { BUSINESS, TEAM, OWNER, filled } from '../data/business';
import { person } from '../lib/schema';
// Блоки з порожніми даними (рік заснування, цифри, команда) не виводяться, доки їх не заповнено в business.ts.
const team = TEAM.filter((t) => filled(t.name));
const stats = [
  ['Років досвіду', BUSINESS.yearsExperience],
  ['Виконаних виїздів', BUSINESS.jobsDone],
  ['Середній час приїзду по Києву', BUSINESS.avgArrival && `${BUSINESS.avgArrival} хв`],
].filter(([, v]) => v);
---
<Base title="Про KyivLock — майстри аварійного відкриття замків у Києві" description="Хто ми: команда майстрів KyivLock, досвід, обладнання, реєстраційні дані та принципи роботи. Відкриваємо замки лише власникам. Дзвоніть {PHONE}." path="/pro-nas/" crumbs={[{ name: 'Про нас', href: '/pro-nas/' }]} schema={team.map(person)}>
  <Hero h1="Про KyivLock: майстри, яким довіряють доступ до дому" lead={`Ми — команда майстрів з аварійного відкриття та ремонту замків, яка працює в Києві й області${BUSINESS.foundedYear ? ` з ${BUSINESS.foundedYear} року` : ''}. Наш принцип простий: швидко, без пошкоджень, за чесною ціною і тільки для власника.`} />
  <section class="section"><div class="wrap prose">
    {stats.length > 0 && <><h2>KyivLock у цифрах</h2>
    <ul>{stats.map(([k, v]) => <li>{k}: <strong>{v}</strong></li>)}</ul></>}
    {OWNER !== BUSINESS.brand && <><h2>Реєстраційні дані</h2>
    <p>{OWNER}{BUSINESS.address && `. Адреса: ${BUSINESS.address}`}. Працюємо офіційно як ФОП, укладаємо договори з юридичними особами.</p></>}
    <h2>Обладнання</h2>
    <p>Професійні набори для неруйнівного відкриття циліндрових і сувальдних замків, декодери Lishi, пневмоподушки для авто, електронний верстат для ключів, програматори транспондерів і смарт-ключів, екстрактори уламків ключів, діагностичні сканери OBD.</p>
    <h2>Наші принципи</h2>
    <ul>
      <li>Відкриваємо лише власникам і мешканцям — перевіряємо документи в кожному випадку.</li>
      <li>Фіксована ціна до початку робіт, без доплат на місці.</li>
      <li>Неруйнівне відкриття — пріоритет; висвердлювання лише за згодою клієнта.</li>
      <li>Не зберігаємо копії ключів і кодів клієнтів.</li>
      <li>Чесно кажемо, якщо задачу краще вирішити інакше (наприклад, через офіційний сервіс авто).</li>
    </ul>
  </div></section>
  {team.length > 0 && <section class="section soft"><div class="wrap">
    <h2>Команда майстрів</h2>
    <div class="grid g3">{team.map((t) => (
      <div class="card"><W type="img" file={t.photo} alt={`${t.name} — ${t.role}, KyivLock`} sizes="(min-width: 960px) 360px, 100vw" />
        <h3>{t.name}</h3><p class="muted">{t.role}{filled(t.exp) && `. Досвід: ${t.exp} років`}.</p><p>{t.about}</p></div>
    ))}</div>
  </div></section>}
  <Blocks type="ownership" seed="about" />
  <Blocks type="advantages" />
</Base>
